<UserControl x:Class="ProjectReport.Views.Inventory.AdditionalChargeView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Border Background="LightYellow" Padding="12">
        <DockPanel LastChildFill="True">
            <!-- Cabecera: contador a la izquierda, ADD a la derecha -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AdditionalChargeView - items: " FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Charges.Count}" Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="ADD" Command="{Binding AddCommand}" Width="100" Margin="6,0"/>
                </StackPanel>
            </Grid>

            <!-- Footer docked bottom -->
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                <Border BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="6" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Daily Total (Additional)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DailyTotalCost, StringFormat=N2}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="Daily Total (Products+Whole+Add)" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CombinedDailyTotal, StringFormat=N2}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Error}" Foreground="Red" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="RELOAD" Command="{Binding ReloadCommand}" Width="100" Margin="6,0"/>
                    <Button Content="SAVE" Command="{Binding SaveCommand}" Width="100" Margin="6,0"/>
                </StackPanel>
            </DockPanel>

            <!-- DataGrid ocupa lo restante -->
            <DataGrid ItemsSource="{Binding Charges}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      MinRowHeight="34"
                      Margin="0"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Charge" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.DefaultChargeNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Unit" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.UnitOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False"
                                          Width="110"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Currency" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Currency}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.CurrencyOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False"
                                          Width="110"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Qty"
                                        Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Unit $"
                                        Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Total"
                                        Binding="{Binding Total, Mode=OneWay, StringFormat=N2}"
                                        Width="120"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Observations"
                                        Binding="{Binding Observations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="2*"/>

                    <DataGridTemplateColumn Header="Actions" Width="100" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="DELETE" Width="80" Margin="4,0"
                                        Click="RowDelete_Click"
                                        Tag="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>