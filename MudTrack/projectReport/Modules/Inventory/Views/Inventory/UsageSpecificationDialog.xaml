<Window x:Class="ProjectReport.Views.Inventory.UsageSpecificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage Specification" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F9FAFB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Specify Detailed Usage" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Product: " Foreground="#6B7280"/>
                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="#374151"/>
                <TextBlock Text=" (" Foreground="#6B7280"/>
                <TextBlock Text="{Binding Unit}" Foreground="#6B7280"/>
                <TextBlock Text=")" Foreground="#6B7280"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Specifications}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                  RowHeight="40">
            <DataGrid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Usage Type" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.UsageTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding UsageType, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Detail (Fluid/Activity)" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <ComboBox ItemsSource="{Binding DataContext.Fluidptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Movement.OriginOrUse, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding IsFluidType, Converter={StaticResource BoolToVisibility}}"/>
                                <ComboBox ItemsSource="{Binding DataContext.ActivityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Movement.OriginOrUse, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding IsActivityType, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Quantity" Binding="{Binding Movement.Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="80"/>

                <DataGridTemplateColumn Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="X" 
                                    Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Foreground="#EF4444" Background="Transparent" BorderThickness="0"
                                    FontWeight="Bold" Padding="10,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="+ ADD USE" Command="{Binding AddEntryCommand}" 
                    Width="100" Height="32" Margin="0,0,10,0"
                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
            <Button Content="SAVE" Click="SaveButton_Click" 
                    Width="100" Height="32" Margin="0,0,10,0"
                    Background="#10B981" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
            <Button Content="CANCEL" Click="CancelButton_Click" 
                    Width="100" Height="32"
                    Background="#9CA3AF" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>

