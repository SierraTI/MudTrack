<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1701</NoWarn>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Win32Icon>Assets\app.ico</Win32Icon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Data\Lista.xlsx" />
    <None Remove="Data\ListaFluidos.xlsx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\Lista.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\ListaFluidos.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\default_products.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
	  <Content Include="Data\HoleSizeList.xlsx">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
  </ItemGroup>
	<ItemGroup>
		<Content Include="Data\PosterMapa.pdf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
    <Resource Include="Assets\FooterLogo.png" />
    <EmbeddedResource Include="Resources\default_products.json" />
  </ItemGroup>


  <ItemGroup>
    <Folder Include="Modules\Inventory\Legacy\Models\" />
    <Folder Include="Modules\Inventory\Legacy\Services\" />
    <Folder Include="Modules\Inventory\Legacy\ViewModels\" />
    <Folder Include="Views\Geometry\Modals\" />
    <Folder Include="Views\Geometry\ThermalGradient\" />
  </ItemGroup>

  <!-- Exclude tools/test projects from main compilation wildcards -->
  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
    <Content Remove="Tools\**\*" />
    <None Remove="Tools\**\*" />
    <EmbeddedResource Remove="Tools\**\*" />
  </ItemGroup>

</Project>



