<UserControl x:Class="ProjectReport.Views.Geometry.ThermalGradientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:converters="clr-namespace:ProjectReport.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#FAFBFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility"/>

        <!-- Palette -->
        <SolidColorBrush x:Key="AccentBrush" Color="#F97316"/>
        <SolidColorBrush x:Key="AccentBrushDark" Color="#EA580C"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PageBgBrush" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E6E8EB"/>
        <SolidColorBrush x:Key="BorderBrushInput" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#374151"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrushDark}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrushDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDEFF2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerIconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFB"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="RowHeight" Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEF0F3"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Tabla compacta -->
            <RowDefinition Height="Auto"/>   <!-- Banner gradiente -->
            <RowDefinition Height="6*"/>       <!-- Gráfica (60% del espacio) -->
        </Grid.RowDefinitions>

        <!-- PARTE SUPERIOR: Tabla de Configuración Compacta -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Action Bar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="+ Add Point"
                            Command="{Binding AddPointCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="[Sync TVD]"
                            Command="{Binding SyncWithSurveyCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Trae el TVD máximo automáticamente para que la gráfica no quede corta o larga."/>
                </StackPanel>

                <!-- Data Table -->
                <DataGrid Grid.Row="1"
                          x:Name="ThermalDataGrid"
                          ItemsSource="{Binding ThermalGradientPoints}"
                          Style="{StaticResource ModernDataGrid}"
                          SelectionMode="Single"
                          MaxHeight="180"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAnomalous}" Value="True">
                                    <Setter Property="Background" Value="#FFFFF4E6"/>
                                    <Setter Property="BorderBrush" Value="#FFFF9800"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                    <Setter Property="Background" Value="#FFFEF2F2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- No. -->
                        <DataGridTextColumn Header="No."
                                            Binding="{Binding Id}"
                                            Width="40"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Punto de Control -->
                        <DataGridTextColumn Header="Punto de Control"
                                            Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#6366F1"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- TVD (ft) -->
                        <DataGridTextColumn Header="TVD (ft)"
                                            Binding="{Binding TVD, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#856404"/>
                                            <Setter Property="Background" Value="#FFF7ED"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Temperatura (°F) -->
                        <DataGridTextColumn Header="Temperatura (°F)"
                                            Binding="{Binding Temperature, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#856404"/>
                                            <Setter Property="Background" Value="#FFF7ED"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Acciones -->
                        <DataGridTemplateColumn Header="Acciones" Width="70" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️"
                                            Style="{StaticResource DangerIconButton}"
                                            Command="{Binding DataContext.DeletePointCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Eliminar punto"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Validation Message -->
                <TextBlock Grid.Row="1"
                           Text="{Binding ValidationMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12"
                           FontWeight="Medium"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Right"
                           Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- PARTE MEDIA: Banner de Resumen de Gradiente -->
        <Border Grid.Row="1" 
                Background="#FEF2F2"
                BorderBrush="#EF4444"
                BorderThickness="2"
                CornerRadius="8"
                Padding="20,12"
                Margin="0,0,0,15"
                HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Calculated Geothermal Gradient:"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="#1F2937"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>
                <Border Background="#EF4444" CornerRadius="4" Padding="8,4">
                    <TextBlock Text="{Binding AverageGradient, StringFormat='{}{0:F2} °F / 100 ft'}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- PARTE INFERIOR: Gráfica Profesional -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="0"
                Margin="0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Chart Title -->
                <TextBlock Grid.Row="0"
                           Text="Temperature Profile"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="18,16,18,0"
                           Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Placeholder when no data -->
                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="18"
                        Padding="40"
                        Visibility="{Binding ShowChart, Converter={StaticResource InvertedBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📉" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="#C7CBD1"/>
                        <TextBlock Text="Insufficient data to render chart"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Add at least 2 points to see a profile."
                                   FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Chart Area -->
                <Grid Grid.Row="1"
                      Margin="18,10,18,18"
                      Visibility="{Binding ShowChart, Converter={StaticResource BoolToVisibility}}">
                    
                    <!-- Background Heat Gradient -->
                    <Border CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F0F9FF" Offset="0"/> <!-- Very Light Blue (Cool Surface) -->
                                <GradientStop Color="#FFF1F2" Offset="1"/> <!-- Very Light Red (Hot Bottom) -->
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    
                    <!-- Chart -->
                    <lvc:CartesianChart Series="{Binding SeriesCollection}"
                                        LegendLocation="None"
                                        Zoom="None"
                                        Hoverable="True"
                                        VisualElements="{Binding VisualElements}"
                                        Background="Transparent">
                        
                        <lvc:CartesianChart.DataTooltip>
                            <lvc:DefaultTooltip SelectionMode="SharedYValues" 
                                                ShowTitle="False"
                                                BulletSize="10"/>
                        </lvc:CartesianChart.DataTooltip>
                        
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Temperature (°F)" 
                                      Position="RightTop"
                                      LabelFormatter="{Binding XFormatter}"
                                      Foreground="{StaticResource TextPrimary}"
                                      FontSize="11"
                                      FontWeight="SemiBold">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Stroke="#F3F4F6" StrokeThickness="1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Depth (TVD) - ft" 
                                      LabelFormatter="{Binding YFormatter}"
                                      MinValue="{Binding YAxisMinValue}"
                                      MaxValue="{Binding YAxisMaxValue}"
                                      Sections="{Binding AxisSections}"
                                      Foreground="{StaticResource TextPrimary}"
                                      FontSize="11"
                                      FontWeight="SemiBold">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1000" Stroke="#F3F4F6" StrokeThickness="1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</UserControl>
