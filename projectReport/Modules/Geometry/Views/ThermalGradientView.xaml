<UserControl x:Class="ProjectReport.Views.Geometry.ThermalGradientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:converters="clr-namespace:ProjectReport.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="#FAFBFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility"/>
        <converters:IsGreaterThanConverter x:Key="GreaterThanConverter"/>
        <converters:LessThanConverter x:Key="LessThanConverter"/>

        <!-- Palette -->
        <SolidColorBrush x:Key="AccentBrush" Color="#F97316"/>
        <SolidColorBrush x:Key="AccentBrushDark" Color="#EA580C"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PageBgBrush" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E6E8EB"/>
        <SolidColorBrush x:Key="BorderBrushInput" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#374151"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        
        <!-- Brand Gradients -->
        <LinearGradientBrush x:Key="BrandGradientPrimary" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrushDark}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrushDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDEFF2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFB"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="RowHeight" Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEF0F3"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Input Field Style -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F97316"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FFFAF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" /> <!-- Input Panel -->
            <ColumnDefinition Width="*" />   <!-- Chart Panel -->
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: INPUTS & SUMMARY -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Summary Cards -->
                <RowDefinition Height="*" />    <!-- DataGrid -->
                <RowDefinition Height="Auto" /> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Summary Cards (Vertical Stack) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <!-- Surface & BHT -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Surface Temp -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Surface Temp" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SurfaceTemperature, StringFormat=N1}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="°F" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="4,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- BHT -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Bottom Hole Temp" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding BottomHoleTemperature, StringFormat=N1}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="°F" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="4,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Average Gradient -->
                <Border Style="{StaticResource Card}" Padding="12" Background="{StaticResource BrandGradientPrimary}">
                    <StackPanel>
                        <TextBlock Text="Avg Gradient (Surface - BHT)" FontSize="11" Foreground="White" Opacity="0.9" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding AverageGradient, StringFormat=N2}" FontSize="24" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="°F / 100ft" FontSize="12" Foreground="White" Opacity="0.9" Margin="6,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- DataGrid -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding ThermalGradientPoints}" 
                          Style="{StaticResource ModernDataGrid}"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <!-- Label (Read Only for Fixed) -->
                        <DataGridTextColumn Header="Point" Binding="{Binding Label}" Width="80" IsReadOnly="False" />
                        
                        <!-- TVD -->
                        <DataGridTextColumn Header="TVD (ft)" Binding="{Binding TVD, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Temperature -->
                        <DataGridTextColumn Header="Temp (°F)" Binding="{Binding Temperature, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnomalous}" Value="True">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Gradient (Calculated) -->
                        <DataGridTextColumn Header="Grad." Binding="{Binding CalculatedGradient, StringFormat=N2, TargetNullValue='-'}" Width="60" IsReadOnly="True" Foreground="{StaticResource TextSecondary}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CalculatedGradient, Converter={StaticResource GreaterThanConverter}, ConverterParameter=4.0}" Value="True">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CalculatedGradient, Converter={StaticResource LessThanConverter}, ConverterParameter=0.0}" Value="True">
                                            <Setter Property="Foreground" Value="#EF4444" /> <!-- Negative gradient -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <!-- Delete Action -->
                        <DataGridTemplateColumn Header="" Width="40">
                             <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.DeletePointCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="Delete Point">
                                        <Path Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19ZM19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4Z" 
                                              Fill="#9CA3AF" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAnomalous}" Value="True">
                                    <Setter Property="Background" Value="#FEF2F2" /> <!-- Red-50 tint -->
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasValidationWarning}" Value="True">
                                    <Setter Property="Background" Value="#FEF2F2" />
                                    <Setter Property="ToolTip" Value="{Binding ValidationMessage}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Button Command="{Binding AddControlPointCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" />
                        <TextBlock Text="Add Intermediate Point" />
                    </StackPanel>
                </Button>
                
                <TextBlock Text="{Binding ValidationMessage}" 
                           Foreground="#EF4444" 
                           FontSize="12" 
                           TextWrapping="Wrap" 
                           Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- RIGHT COLUMN: PROFESSIONAL CHART -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Thermal Profile (Temperature vs TVD)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" />

                <!-- Chart: Inverted Y-Axis, Top X-Axis -->
                <lvc:CartesianChart Grid.Row="1" LegendLocation="None" Hoverable="True" DataTooltip="{x:Null}">
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="True Vertical Depth (ft)" 
                                  MinValue="{Binding YAxisMinValue}" 
                                  MaxValue="{Binding YAxisMaxValue}" 
                                  LabelFormatter="{Binding YFormatter}"
                                  Sections="{Binding AxisSections}"
                                  Foreground="{StaticResource TextSecondary}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Stroke="#E5E7EB" StrokeThickness="1" StrokeDashArray="2,2" />
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>

                    <!-- X-Axis on Top (LeftBottom in LiveCharts but styled here) -->
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Title="Temperature (°F)" 
                                  MinValue="{Binding XAxisMinValue}" 
                                  MaxValue="{Binding XAxisMaxValue}" 
                                  LabelFormatter="{Binding XFormatter}"
                                  Position="RightTop" 
                                  Foreground="{StaticResource TextSecondary}"> 
                            <lvc:Axis.Separator>
                                <lvc:Separator Stroke="#E5E7EB" StrokeThickness="1" />
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>

                    <lvc:CartesianChart.Series>
                        <!-- Main Line (Blue) -->
                        <lvc:LineSeries Title="Thermal Profile"
                                        Values="{Binding SeriesCollection[0].Values}"
                                        PointGeometry="{x:Static lvc:DefaultGeometries.Square}"
                                        PointGeometrySize="8"
                                        Stroke="#3B82F6"
                                        StrokeThickness="2"
                                        Fill="Transparent" 
                                        LineSmoothness="0.5" />
                        
                        <!-- Anomalies (Red Segments/Points) -->
                        <lvc:LineSeries Title="Anomalies"
                                        Values="{Binding SeriesCollection[1].Values}"
                                        PointGeometry="{x:Static lvc:DefaultGeometries.Diamond}"
                                        PointGeometrySize="10"
                                        PointForeground="Red"
                                        Stroke="#EF4444"
                                        Fill="Transparent"
                                        StrokeThickness="0" /> 
                        
                        <!-- Reference Line -->
                        <lvc:LineSeries Values="{Binding SeriesCollection[2].Values}" 
                                        Stroke="Gray" StrokeThickness="1" StrokeDashArray="4" Fill="Transparent" PointGeometry="{x:Null}" />
                        
                        <!-- Prediction Line -->
                         <lvc:LineSeries Values="{Binding SeriesCollection[3].Values}" 
                                         Stroke="Orange" StrokeThickness="2" StrokeDashArray="2" Fill="Transparent" PointGeometry="{x:Null}" />
                    </lvc:CartesianChart.Series>
                    


                </lvc:CartesianChart>
            </Grid>
        </Border>
    </Grid>
</UserControl>
