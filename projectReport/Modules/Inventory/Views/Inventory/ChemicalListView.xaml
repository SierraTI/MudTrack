<UserControl x:Class="ProjectReport.Views.Inventory.ChemicalListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Chemical List - Select Products" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding TotalItems, StringFormat='({0} Total)'}" FontSize="14" Margin="12,0,0,0" Foreground="#666"/>
        </StackPanel>

        <!-- Search and Filter Bar -->
        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,8"
                Background="#F9FAFB">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍 Search:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchTextBox" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="250" 
                         Padding="8"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Foreground="#374151"/>
                
                <TextBlock Text="Category:" FontSize="12" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="CategoryCombo" 
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Width="180" 
                          Padding="8"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"
                          BorderBrush="#D1D5DB"
                          BorderThickness="1">
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Stats Bar -->
        <Border Grid.Row="2"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Background="#FFFBEB">
            <DockPanel LastChildFill="False">
                <Border BorderThickness="0" Background="#FEF3C7" CornerRadius="4" Padding="12,6" DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total:" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding TotalItems}" FontWeight="Bold" Foreground="#92400E"/>
                    </StackPanel>
                </Border>

                <Border BorderThickness="0" Background="#DCFCE7" CornerRadius="4" Padding="12,6" Margin="8,0,0,0" DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Selected:" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Foreground="#166534"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Content="Select All" Width="100" Command="{Binding SelectAllCommand}" 
                           Margin="8,0" Background="#3B82F6" Foreground="White" Padding="8,4"/>
                    <Button Content="Clear Selection" Width="120" Command="{Binding ClearSelectionCommand}" 
                           Margin="0,0,8,0" Background="#EF4444" Foreground="White" Padding="8,4"/>
                    <Button Content="✓ SAVE" Width="120" Command="{Binding SaveCommand}" 
                           Background="#10B981" Foreground="White" Padding="8,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DataGrid with Scrolling -->
        <Border Grid.Row="4"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0"
                Margin="0,0,0,8"
                Background="White">
            <DataGrid x:Name="ChemicalsDataGrid"
                      ItemsSource="{Binding ChemicalItemsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      SelectionUnit="CellOrRowHeader"
                      SelectionMode="Single"
                      RowHeight="32"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="White">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Height" Value="36"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="0">
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F9FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="50"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Nombre}" Width="180"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Descripcion}" Width="200"/>
                    <DataGridTextColumn Header="Physical State" Binding="{Binding EstadoFisico}" Width="100"/>
                    <DataGridTextColumn Header="Presentation" Binding="{Binding Presentacion}" Width="100"/>
                    <DataGridTextColumn Header="Qty/Package" Binding="{Binding Cantidad}" Width="90"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unidad}" Width="70"/>
                    <DataGridTextColumn Header="SG" Binding="{Binding SG}" Width="60"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Categoria}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Info -->
        <TextBlock Grid.Row="5" Text="Scroll horizontally to see all columns • Use checkboxes to select products for your daily report" 
                   FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>

    </Grid>
</UserControl>
