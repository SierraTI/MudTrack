<UserControl x:Class="ProjectReport.Views.Inventory.InventoryDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProjectReport.Views.Inventory"
             xmlns:inv="clr-namespace:ProjectReport.Views.Inventory">
    <UserControl.Resources>
        <local:AlternationIndexToNumberConverter x:Key="IndexToNumberConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,8">
            <TabItem Header="Chemical List">
                <local:ChemicalListView />
            </TabItem>

            <TabItem Header="Stock">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <!-- Row added for Ticket History dentro de Products -->
                    </Grid.RowDefinitions>

                    <!-- Ticket buttons (solo para Products) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Ticket Received" Width="160" Margin="0,0,10,0" Command="{Binding OpenTicketReceivedCommand}"/>
                        <Button Content="Ticket Returned" Width="160" Margin="0,0,10,0" Command="{Binding OpenTicketReturnedCommand}"/>
                    </StackPanel>

                    <!-- Ticket History moved inside Products tab -->
                    <GroupBox Header="Ticket History" Margin="8" Grid.Row="4" Grid.ColumnSpan="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                <!-- Command target: embedded panel's DataContext -->
                                <Button Content="Refresh History" Command="{Binding DataContext.RefreshCommand, ElementName=InventoryHistoryPanel}" Margin="0,0,8,0" />
                                <Button Content="Open Full History" Click="OpenInventoryHistory_Click" />
                            </StackPanel>

                            <!-- Embebe la vista de historial (ya existe: InventoryHistoryView) -->
                            <inv:InventoryHistoryView x:Name="InventoryHistoryPanel" Grid.Row="1" />
                        </Grid>
                    </GroupBox>

                </Grid>
            </TabItem>

            <TabItem Header="Usage">
                <local:UsageView />
            </TabItem>

            <TabItem Header="Whole Fluids">
                <local:WholeFluidsView />
            </TabItem>

            <TabItem Header="Additional Charge">
                <local:AdditionalChargeView />
            </TabItem>
        </TabControl>

        <!-- El GroupBox global se ha eliminado para que el historial solo se muestre dentro de Products -->

    </Grid>
</UserControl>