<UserControl x:Class="ProjectReport.Views.Inventory.InventoryHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- Column header style -->
        <Style x:Key="ColHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#F3F4F6"/>
            <Setter Property="Foreground"      Value="#374151"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height"          Value="34"/>
        </Style>

        <!-- Row style: ticket list -->
        <Style x:Key="TicketRowStyle" TargetType="DataGridRow">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row style: line items -->
        <Style x:Key="LineRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Ticket list -->
            <RowDefinition Height="0.45*" MinHeight="100"/>
            <!-- Splitter handle -->
            <RowDefinition Height="5"/>
            <!-- Detail panel (collapsed until selection) -->
            <RowDefinition Height="0.55*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•  TOP: Ticket List  â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Border Grid.Row="0"
                BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="6" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter/Action bar -->
                <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tickets" FontSize="13" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Tickets.Count, StringFormat=' ({0})'}" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Command="{Binding RefreshCommand}" 
                                Background="Transparent" BorderThickness="0"
                                Padding="8,4" Cursor="Hand"
                                FontSize="11" Foreground="#3B82F6"
                                Content="&#x1F504; Refresh"/>
                        <Button Command="{Binding ClearOldCommand}" 
                                Background="Transparent" BorderThickness="0"
                                Padding="8,4" Cursor="Hand" Margin="8,0,0,0"
                                FontSize="11" Foreground="#DC2626"
                                Content="Clear Tickets"
                                ToolTip="Remove all stored tickets"/>
                    </StackPanel>
                </Border>

                <!-- Tickets Grid -->
                <DataGrid Grid.Row="1"
                          x:Name="TicketsGrid"
                          ItemsSource="{Binding Tickets}"
                          SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeight="36"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="White"
                          ColumnHeaderStyle="{StaticResource ColHeaderStyle}"
                          RowStyle="{StaticResource TicketRowStyle}"
                          AlternationCount="2">
                    <DataGrid.Columns>

                        <!-- Date -->
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd  HH:mm}}"
                                            Width="140"/>

                        <!-- Ticket # -->
                        <DataGridTextColumn Header="Ticket #"
                                            Binding="{Binding TicketLabel}"
                                            Width="70"/>

                        <!-- Type badge -->
                        <DataGridTemplateColumn Header="Type" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" Margin="4,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Returned">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Consumed">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#065F46"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Returned">
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Consumed">
                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Origin / Use -->
                        <DataGridTextColumn Header="Origin / Use"
                                            Binding="{Binding Origin}"
                                            Width="*" MinWidth="150"/>

                        <!-- User -->
                        <DataGridTextColumn Header="User"
                                            Binding="{Binding User}"
                                            Width="90"/>

                        <!-- Total value -->
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalValueFmt}"
                                            Width="85"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Drag handle -->
        <GridSplitter Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      Background="#D1D5DB"
                      ShowsPreview="False"/>

        <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•  BOTTOM: Ticket Detail Panel  â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
        <Border Grid.Row="2"
                BorderBrush="#3B82F6" BorderThickness="1"
                CornerRadius="6" Background="White"
                Margin="0,0,0,0">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                </Grid.RowDefinitions>

                <!-- â”€â”€ Ticket header strip (cleaned up) â”€â”€ -->
                <Border Grid.Row="0"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE" BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ticket number and type -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontWeight="Bold" FontSize="14" Foreground="#1D4ED8"
                                       VerticalAlignment="Center" Margin="0,0,0,0"
                                       Text="{Binding SelectedTicket.TicketLabel, StringFormat='&#x1F4C4; TICKET {0}'}"/>
                            <Border Background="#DBEAFE" CornerRadius="4" Padding="6,3" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF"
                                           Text="{Binding SelectedTicket.Type}"/>
                            </Border>
                        </StackPanel>

                        <!-- Date -->
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="#374151"
                                   VerticalAlignment="Center" Margin="20,0,0,0">
                            <Run FontWeight="SemiBold">Date:</Run>
                            <Run Text="{Binding SelectedTicket.Date, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                        </TextBlock>

                        <!-- Line count -->
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#374151"
                                   VerticalAlignment="Center" Margin="20,0,0,0">
                            <Run FontWeight="SemiBold">Items:</Run>
                            <Run Text="{Binding TicketLines.Count, Mode=OneWay}"/>
                        </TextBlock>

                        <!-- Right-side actions area -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock FontSize="12" Foreground="#374151">
                                <Run FontWeight="SemiBold">Total:</Run>
                                <Run Text="{Binding SelectedTicket.TotalValueFmt, Mode=OneWay}" Foreground="#059669" FontWeight="Bold" FontSize="13"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- â”€â”€ Metadata row â”€â”€ -->
                <Border Grid.Row="1"
                        Background="White" Padding="16,12"
                        BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <!-- Left info -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Top">
                            <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,4">
                                <Run FontWeight="SemiBold" Foreground="#374151">Supplier:</Run>
                                <Run Text="{Binding SelectedTicket.SupplierName, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,4">
                                <Run FontWeight="SemiBold" Foreground="#374151">User:</Run>
                                <Run Text="{Binding SelectedTicket.User, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,0">
                                <Run FontWeight="SemiBold" Foreground="#374151">Shipment Ref:</Run>
                                <Run Text="{Binding SelectedTicket.ShipmentReference, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Middle info -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Top" Margin="40,0,0,0">
                            <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,4">
                                <Run FontWeight="SemiBold" Foreground="#374151">Origin:</Run>
                                <Run Text="{Binding SelectedTicket.Origin, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,0,0,0">
                                <Run FontWeight="SemiBold" Foreground="#374151">Notes:</Run>
                                <Run Text="{Binding SelectedTicket.Observations, Mode=OneWay}" Foreground="#374151" FontSize="10"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Right side: Line items grid -->
                        <Border DockPanel.Dock="Right" Margin="20,0,0,0" HorizontalAlignment="Stretch">
                            <DataGrid ItemsSource="{Binding TicketLines}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      RowHeight="28"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      Background="White"
                                      ColumnHeaderStyle="{StaticResource ColHeaderStyle}"
                                      RowStyle="{StaticResource LineRowStyle}"
                                      AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code"         Binding="{Binding ProductCode}"  Width="60"/>
                                    <DataGridTextColumn Header="Product"      Binding="{Binding ProductName}"  Width="140"/>
                                    <DataGridTextColumn Header="Qty"          Binding="{Binding Quantity}"     Width="50"/>
                                    <DataGridTextColumn Header="Unit Price"   Binding="{Binding UnitPriceFmt}" Width="70"/>
                                    <DataGridTextColumn Header="Total"        Binding="{Binding TotalFmt}"     Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>
                </Border>

            </Grid>
        </Border>

    </Grid>
</UserControl>


