<Window x:Class="ProjectReport.Views.Inventory.ReportOtherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Otras Actividades" Height="360" Width="660" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Report Consumo (Otras actividades)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Editable table with ComboBox for Process -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Lines}"
                      SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="0,0,12,0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Process" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Process}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Processes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Process, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Controls column -->
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
                <Button Content="Add row" Width="100" Margin="0,0,0,8" Command="{Binding AddRowCommand}"/>
                <Button Content="Remove row" Width="100" Margin="0,0,0,8" Command="{Binding RemoveRowCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="CANCEL" Width="96" Height="30" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <Button Content="SAVE" Width="96" Height="30" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>