<UserControl x:Class="ProjectReport.Views.Inventory.TicketReceivedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Top fields -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <!-- Lines table -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <!-- Bottom actions -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Create Received Ticket"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

        <!-- Top section: Requisition | Origin | Supplier | Shipment Method | ADD -->
        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <!-- Row 1: Requisition, Origin, Supplier -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Requisition -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="# Remision" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding Requisition, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Origin (Dropdown) -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Origin / Storage Base" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 ItemsSource="{Binding StorageBases}"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Code"
                                 SelectedValue="{Binding Origin, UpdateSourceTrigger=PropertyChanged}"
                                 IsEditable="False"/>
                    </StackPanel>

                    <!-- Supplier Name (Conditional) -->
                    <StackPanel Grid.Column="2" Orientation="Vertical">
                        <TextBlock Text="Supplier Name" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Shipment Method, Reference, ADD Button -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Shipment Method -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Shipment Method" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 ItemsSource="{Binding ShipmentMethods}"
                                 SelectedValue="{Binding ShipmentMethod, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Shipment Reference -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Shipment Reference" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding ShipmentReference, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Buttons: ADD, Select Products -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="ADD"
                                Width="80"
                                Height="30"
                                Background="#10B981"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Command="{Binding AddLineCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Select Products"
                                Width="120"
                                Height="30"
                                Background="#3B82F6"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Command="{Binding SelectProductsCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Lines table -->
        <Border Grid.Row="3"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <DataGrid x:Name="LinesDataGrid"
                      ItemsSource="{Binding Lines}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowHeaderWidth="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      MinRowHeight="34"
                      PreparingCellForEdit="LinesDataGrid_PreparingCellForEdit"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Product -->
                    <DataGridTemplateColumn Header="Product" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProductName}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    Height="28"
                                    ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    DisplayMemberPath="SearchLabel"
                                    TextSearch.TextPath="SearchLabel"
                                    IsEditable="True"
                                    IsTextSearchEnabled="False"
                                    StaysOpenOnEdit="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Unit (Display only - auto-filled from product) -->
                    <DataGridTextColumn Header="Unit"
                                        Binding="{Binding Unit, Mode=OneWay}"
                                        Width="80" MinWidth="70"
                                        IsReadOnly="True"/>

                    <DataGridTextColumn Header="Quantity"
                                        Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" MinWidth="80"/>

                    <DataGridTextColumn Header="Unit Price (USD)"
                                        Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                        Width="120" MinWidth="100"/>

                    <DataGridTextColumn Header="Observations"
                                        Binding="{Binding Observations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="2*" MinWidth="160"/>

                    <!-- Remove -->
                    <DataGridTemplateColumn Header="" Width="90" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X"
                                        Width="56"
                                        Height="26"
                                        Background="#DC2626"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="CANCEL"
                    Width="120"
                    Height="34"
                    HorizontalAlignment="Left"
                    Command="{Binding CancelCommand}"/>

            <Button Grid.Column="1"
                    Content="SAVE"
                    Width="140"
                    Height="34"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveCommand}"/>
        </Grid>

        <!-- Mensajes de estado (solo para depuracion) -->
        <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="DarkRed" Margin="0,6,0,6"/>
    </Grid>
</UserControl>
