<UserControl x:Class="ProjectReport.Views.Inventory.TicketReturnedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/> <!-- DataGrid ocupa espacio flexible -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Inventory - Ticket Returned"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <!-- Row 1: Requisition, Destination, Supplier -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
 
                    <!-- Requisition -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="# Remision" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding Requisition, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
 
                    <!-- Destination (TextBox) -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Destination" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
 
                    <!-- Supplier Name -->
                    <StackPanel Grid.Column="2" Orientation="Vertical">
                        <TextBlock Text="Supplier Name" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
 
                <!-- Row 2: Shipment Method, Reference, ADD Button -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
 
                    <!-- Shipment Method (TextBox) -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Shipment Method" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding ShipmentMethod, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
 
                    <!-- Shipment Reference -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Shipment Reference" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding ShipmentReference, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
 
                    <!-- Unified Add Products Button -->
                    <Button Grid.Column="2" 
                            Content="Add Products"
                            Width="160"
                            Height="32"
                            Background="#3B82F6"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Command="{Binding SelectProductsCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <!-- Contenedor flexible para que DataGrid escale -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="LinesDataGrid"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          MinRowHeight="34"
                          Margin="0"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreparingCellForEdit="LinesDataGrid_PreparingCellForEdit"
                          CellEditEnding="LinesDataGrid_CellEditEnding">

                    <DataGrid.Columns>
                        <!-- Product (Combo en edicion) -->
                        <DataGridTemplateColumn Header="Product" Width="2*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                     <TextBlock Text="{Binding ProductName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Height="28"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        DisplayMemberPath="SearchLabel"
                                        TextSearch.TextPath="SearchLabel"
                                        IsEditable="True"
                                        IsTextSearchEnabled="False"
                                        StaysOpenOnEdit="True"
                                        />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Unit (Display only) -->
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=OneWay}" Width="60" MinWidth="50" IsReadOnly="True"/>

                        <!-- Qty Received (Read-only) - shows how much was received -->
                        <DataGridTemplateColumn Header="Qty Received" Width="100" MinWidth="90" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding QuantityReceived}" FontWeight="Bold" Foreground="#059669"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quantity to Return (with validation) -->
                        <DataGridTextColumn Header="Qty Return" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" MinWidth="80"/>

                        <!-- Condition (TextBox in edicion) -->
                        <DataGridTemplateColumn Header="Condition" Width="100" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Condition}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Height="28"
                                             Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Observations -->
                        <DataGridTextColumn Header="Observations" Binding="{Binding Observations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*" MinWidth="180"/>

                        <!-- Remove -->
                        <DataGridTemplateColumn Header="" Width="90" CanUserSort="False" MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="X"
                                            Width="56"
                                            Height="26"
                                            Background="#DC2626"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Click="RemoveButton_Click"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="CANCEL"
                    Width="120"
                    Height="34"
                    HorizontalAlignment="Left"
                    Command="{Binding CancelCommand}"/>

            <Button Grid.Column="1"
                    Content="SAVE"
                    Width="140"
                    Height="34"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</UserControl>
