<UserControl x:Class="ProjectReport.Views.Inventory.TicketReturnedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/> <!-- DataGrid ocupa espacio flexible -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Inventory - Ticket Returned"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <!-- Row 1: Requisition, Destination, Condition -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Requisition -->
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0" HorizontalAlignment="Stretch">
                        <TextBlock Text="# Remision" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Height="30" HorizontalAlignment="Stretch" Text="{Binding Requisition, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Destination (Dropdown) -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,12,0" HorizontalAlignment="Stretch">
                        <TextBlock Text="Destination" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 ItemsSource="{Binding StorageBases}"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Code"
                                 SelectedValue="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                                 IsEditable="True"/>
                    </StackPanel>

                    <!-- Condition (Sealed/Open/Damaged) -->
                    <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Stretch">
                        <TextBlock Text="Product Condition" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox Height="30"
                                 HorizontalAlignment="Stretch"
                                 ItemsSource="{Binding ProductConditions}"
                                 SelectedValue="{Binding Condition, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: ADD Button -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="ADD" Width="72" Height="30" Command="{Binding AddLineCommand}" ToolTip="Add a new return line"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <!-- Contenedor flexible para que DataGrid escale -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="LinesDataGrid"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          MinRowHeight="34"
                          Margin="0"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreparingCellForEdit="LinesDataGrid_PreparingCellForEdit">

                    <DataGrid.Columns>
                        <!-- Product (Combo en edicion) -->
                        <DataGridTemplateColumn Header="Product" Width="2*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Height="28"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        DisplayMemberPath="SearchLabel"
                                        TextSearch.TextPath="SearchLabel"
                                        IsEditable="True"
                                        IsTextSearchEnabled="False"
                                        StaysOpenOnEdit="True"
                                        />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Unit (Display only) -->
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit, Mode=OneWay}" Width="80" MinWidth="70" IsReadOnly="True"/>

                        <!-- Current Stock (Read-only availability check) -->
                        <DataGridTemplateColumn Header="Stock Available" Width="110" MinWidth="90" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentStock}" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quantity to Return (with validation) -->
                        <DataGridTextColumn Header="Qty Return" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" MinWidth="80"/>

                        <!-- Condition (Sealed/Open/Damaged) -->
                        <DataGridTemplateColumn Header="Condition" Width="100" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Condition}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox Height="28"
                                             ItemsSource="{Binding DataContext.ProductConditions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             SelectedValue="{Binding Condition, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Observations -->
                        <DataGridTextColumn Header="Observations" Binding="{Binding Observations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*" MinWidth="180"/>

                        <!-- Validation Error Indicator -->
                        <DataGridTemplateColumn Header="Status" Width="120" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FEE2E2" Padding="4,2" CornerRadius="2" Margin="2">
                                        <TextBlock Foreground="#991B1B" FontSize="11" 
                                                  Text="{Binding ValidationError}"
                                                  TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Remove -->
                        <DataGridTemplateColumn Header="" Width="90" CanUserSort="False" MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="X"
                                            Width="56"
                                            Height="26"
                                            Background="#DC2626"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Click="RemoveButton_Click"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="CANCEL"
                    Width="120"
                    Height="34"
                    HorizontalAlignment="Left"
                    Command="{Binding CancelCommand}"/>

            <Button Grid.Column="1"
                    Content="SAVE"
                    Width="140"
                    Height="34"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</UserControl>
