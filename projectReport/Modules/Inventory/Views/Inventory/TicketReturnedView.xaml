<UserControl x:Class="ProjectReport.Views.Inventory.TicketReturnedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/> <!-- DataGrid ocupa espacio flexible -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Inventory - Ticket Returned"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Remision -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,12,0" HorizontalAlignment="Stretch">
                    <TextBlock Text="# Remision" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Height="30" MinWidth="120" HorizontalAlignment="Stretch" Text="{Binding Requisition, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Origin editable arriba -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,12,0" HorizontalAlignment="Stretch">
                    <TextBlock Text="Origin" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Height="30" MinWidth="120" HorizontalAlignment="Stretch" Text="{Binding Origin, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Button Content="ADD" Width="72" Height="30" Command="{Binding AddLineCommand}" ToolTip="Add a new line"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <!-- Contenedor flexible para que DataGrid escale -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="LinesDataGrid"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          MinRowHeight="34"
                          Margin="0"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreparingCellForEdit="LinesDataGrid_PreparingCellForEdit">

                    <DataGrid.Columns>
                        <!-- Product (Combo en edicion) -->
                        <DataGridTemplateColumn Header="Product" Width="2*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Height="28"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        DisplayMemberPath="SearchLabel"
                                        TextSearch.TextPath="SearchLabel"
                                        IsEditable="True"
                                        IsTextSearchEnabled="False"
                                        StaysOpenOnEdit="True"
                                        />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Unit Price removed for Returned tickets -->

                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110" MinWidth="80"/>
                        <DataGridTextColumn Header="Origin" Binding="{Binding Context}" Width="2*" MinWidth="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Observations" Binding="{Binding Observations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*" MinWidth="180"/>

                        <!-- Remove -->
                        <DataGridTemplateColumn Header="" Width="90" CanUserSort="False" MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="X"
                                            Width="56"
                                            Height="26"
                                            Background="#DC2626"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Click="RemoveButton_Click"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="CANCEL"
                    Width="120"
                    Height="34"
                    HorizontalAlignment="Left"
                    Command="{Binding CancelCommand}"/>

            <Button Grid.Column="1"
                    Content="SAVE"
                    Width="140"
                    Height="34"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</UserControl>
