<UserControl x:Class="ProjectReport.Views.Inventory.WholeFluidsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Botones encima de la tabla (ADD, etc.) -->
            <RowDefinition Height="8"/>     <!-- Spacer -->
            <RowDefinition Height="*"/>     <!-- DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8" >
            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="# Remision" FontWeight="SemiBold"/>
                <TextBox Width="220" Text="{Binding Requisition, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="Origin" FontWeight="SemiBold"/>
                <TextBox Width="220" Text="{Binding Origin, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="Tipo movimiento" FontWeight="SemiBold"/>
                <ComboBox Width="140" SelectedValuePath="Content" SelectedValue="{Binding MovementType}" >
                    <ComboBoxItem Content="Ingreso"/>
                    <ComboBoxItem Content="Salida"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="Fecha" FontWeight="SemiBold"/>
                <!-- DatePicker para permitir seleccionar fecha -->
                <DatePicker Width="180" SelectedDate="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                <TextBlock Text="Observacion" FontWeight="SemiBold"/>
                <TextBox Width="320" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Button Content="Cargar catalogo" Width="120" Height="30" Margin="8,18,0,0" Command="{Binding AddAllFromCatalogCommand}"/>
            <Button Content="Cargar ultimo movimiento" Command="{Binding LoadLastMovementCommand}" Margin="8,18,0,0"/>
        </StackPanel>

        <!-- Panel de botones encima de la tabla (ADD) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,4">
            <!-- ahora llama al manejador en code-behind para controlar selección/edición -->
            <Button Content="ADD" Width="80" Height="30" Margin="0,0,8,0" Click="AddButton_Click"/>
        </StackPanel>

        <!-- DataGrid: columnas ordenadas según requerimiento -->
        <DataGrid x:Name="LinesDataGrid" Grid.Row="3"
                  ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionChanged="DataGrid_SelectionChanged"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <!-- # Remision -->
                <DataGridTemplateColumn Header="# Remision" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.Requisition, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Tipo movimiento -->
                <DataGridTemplateColumn Header="Tipo movimiento" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.MovementType, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Fluido -->
                <DataGridTemplateColumn Header="Fluido" Width="3*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProductName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox Height="28"
                                      ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Barriles -->
                <DataGridTextColumn Header="Barriles" Binding="{Binding Barrels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />

                <!-- Precio -->
                <DataGridTextColumn Header="Precio" Binding="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="120" />

                <!-- Origin -->
                <DataGridTemplateColumn Header="Origin" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.Origin, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Fecha -->
                <DataGridTemplateColumn Header="Fecha" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.Date, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Observacion -->
                <DataGridTemplateColumn Header="Observacion" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataContext.Reference, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="{Binding Error}" Foreground="Red" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="CANCEL" Width="110" Command="{Binding CancelCommand}"/>
            <Button Content="SAVE" Width="110" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>