<UserControl x:Class="ProjectReport.Views.Inventory.WholeFluidsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/> <!-- DataGrid + footer en DockPanel -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="0"/>

        <!-- Border que contiene DataGrid y footer (DockPanel garantiza que el footer siempre quede visible) -->
        <Border Grid.Row="3"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <DockPanel LastChildFill="True">

                <!-- Footer fijo en la parte inferior -->
                <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                    <Border BorderThickness="1" BorderBrush="#DDDDDD" CornerRadius="6" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Daily Total Cost" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DailyTotalCost, StringFormat=N2}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Error}" Foreground="Red" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="SAVE" Width="110" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
                        <Button Content="CANCEL" Width="110" Margin="8,0,0,0"/>
                        <Button Content="ADD" Width="110" Click="AddButton_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- DataGrid ocupa el resto del espacio -->
                <DataGrid x:Name="LinesDataGrid"
                          ItemsSource="{Binding WholeFluids}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          SelectionUnit="CellOrRowHeader"
                          SelectionMode="Single"
                          PreparingCellForEdit="LinesDataGrid_PreparingCellForEdit"
                          MouseDoubleClick="LinesDataGrid_MouseDoubleClick"
                          SelectionChanged="DataGrid_SelectionChanged"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalAlignment="Stretch"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="# Remision" Width="140"
                                            Binding="{Binding Requisition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Tipo movimiento (Ingreso/Salida) con filtro en el header -->
                        <DataGridTemplateColumn Width="140">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="Tipo movimiento" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <!-- IMPORTANT: SelectedValuePath=Content para devolver string -->
                                        <ComboBox Width="120" SelectionChanged="MovementFilter_SelectionChanged" SelectedValuePath="Content">
                                            <ComboBoxItem Content="Todos" IsSelected="True"/>
                                            <ComboBoxItem Content="Ingreso"/>
                                            <ComboBoxItem Content="Salida"/>
                                        </ComboBox>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>

                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding MovementType}" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                              <DataTemplate>
                                <!-- SelectedValuePath=Content para que MovementType reciba la cadena -->
                                <ComboBox SelectedValue="{Binding MovementType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          IsEditable="False" Height="24">
                                  <ComboBoxItem Content="Ingreso"/>
                                  <ComboBoxItem Content="Salida"/>
                                </ComboBox>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Fluido" Width="3*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductName}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox Height="28"
                                              ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Code"
                                              SelectedValue="{Binding ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              StaysOpenOnEdit="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Barriles" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                        <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="120" />
                        <DataGridTextColumn Header="Origin" Binding="{Binding Context, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" />

                        <DataGridTemplateColumn Header="Fecha" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Observacion" Binding="{Binding Observations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />

                        <DataGridTemplateColumn Header="Acciones" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="TRANSFER" Width="70" Margin="4,0" 
                                               Command="{Binding DataContext.TransferFluidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Load fluid to Primary Fluid Set"/>
                                        <Button Content="EDIT" Width="60" Margin="4,0" Click="RowEdit_Click" Tag="{Binding}"/>
                                        <Button Content="DELETE" Width="60" Margin="4,0" Click="RowDelete_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>