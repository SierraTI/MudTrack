<UserControl x:Class="ProjectReport.Modules.ReportDetails.Views.ReportDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjectReport.Modules.ReportDetails.Views"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Brand tokens -->
        <SolidColorBrush x:Key="BrandOrange" Color="#F57C1F"/>
        <SolidColorBrush x:Key="BrandOrangeHover" Color="#EF6C00"/>
        <SolidColorBrush x:Key="BrandOrangePressed" Color="#E65100"/>

        <SolidColorBrush x:Key="Surface" Color="White"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E6E8EB"/>
        <SolidColorBrush x:Key="TextStrong" Color="#111827"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

        <!-- Button base -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="10"
                          SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary (neutral) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF3F4F6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFE5E7EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary (orange) -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource BrandOrange}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandOrange}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="140"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandOrangeHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrandOrangeHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandOrangePressed}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrandOrangePressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Outline orange (for Save Draft) -->
        <Style x:Key="OutlineOrangeButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandOrange}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandOrange}"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="14,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFF7ED"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFFFEDD5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ===== Palette (keep consistent with the wizard) ===== -->
        <SolidColorBrush x:Key="AccentBrush" Color="#F97316"/>
        <SolidColorBrush x:Key="AccentBrushDark" Color="#EA580C"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E6E8EB"/>
        <SolidColorBrush x:Key="BorderBrushInput" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#374151"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

        <!-- Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Titles -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SubtleHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- TextBox (rounded + focus naranja) -->
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary add button (naranja) -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrushDark}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrushDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger icon button (soft red, consistente) -->
        <Style x:Key="RemoveIconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row item (más pro: hover) -->
        <Style x:Key="PersonRowCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#EEF0F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="PersonName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- Subtitle -->
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- Labels -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <!-- Required star -->
        <Style x:Key="RequiredStar" TargetType="TextBlock">
            <Setter Property="Text" Value=" *"/>
            <Setter Property="Foreground" Value="Red"/>
        </Style>

        <!-- App background -->
        <SolidColorBrush x:Key="AppBg" Color="#F9FAFB"/>

        <!-- Hint styles -->
        <SolidColorBrush x:Key="HintBg" Color="#FFF7ED"/>
        <SolidColorBrush x:Key="HintBorder" Color="#FED7AA"/>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#92400E"/>
        </Style>

        <!-- Link button -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        
    </UserControl.Resources>

    <Border Background="{StaticResource AppBg}">

        <!-- SCROLL PRINCIPAL -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

            <!-- PADDING GENERAL -->
            <Border Padding="24">

                <!-- CONTENEDOR PRINCIPAL -->
                <Grid>

                    <StackPanel>

                        <!-- HEADER -->
                        <Border Background="Transparent"
                            Padding="0,2,0,14">

                            <StackPanel>

                                <TextBlock Text="Report Details"
                                       Style="{StaticResource PageTitle}"/>


                                <TextBlock Text="Complete the required fields. Validation will show inline if something is off."
                                       Style="{StaticResource PageSubtitle}"/>

                            </StackPanel>

                        </Border>


                        <!-- ================= GENERAL ================= -->
                        <Border Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="General Well Information"
                                       Style="{StaticResource SectionTitle}"/>

                                <UniformGrid Columns="4"
                                         Margin="0,0,0,14">

                                    <StackPanel Margin="6">
                                        <TextBlock Text="Interval #"
                                               Style="{StaticResource FieldLabel}"/>
                                        <TextBox Margin="0,6,0,0"
                                                  Text="{Binding Report.IntervalNumber,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Margin="6">
                                        <TextBlock Text="Report #"
               Style="{StaticResource FieldLabel}"/>
                                        <TextBox Margin="0,6,0,0"
             Text="{Binding Report.ReportNumber, Mode=TwoWay}"
             IsEnabled="False"/>
                                        <!-- No editable y gris -->
                                    </StackPanel>


                                    <StackPanel Grid.Column="0" Margin="6">

                                        <TextBlock 
        Text="Interval Size (in)" 
        Style="{StaticResource FieldLabel}"/>

                                        <ComboBox
        ItemsSource="{Binding HoleSizeOptions}"
        SelectedItem="{Binding Report.IntervalSizeIn, Mode=TwoWay}"
        Height="35"
        FontSize="14"
        Margin="0,5,0,0"/>

                                    </StackPanel>



                                    <StackPanel Margin="6">
                                        <TextBlock Text="Report Date"
                                               Style="{StaticResource FieldLabel}"/>
                                        <DatePicker Margin="0,6,0,0"
            SelectedDate="{Binding Report.ReportDateTime,
                                   Mode=TwoWay}"/>

                                    </StackPanel>

                                </UniformGrid>


                                <UniformGrid Columns="2">

                                    <StackPanel Margin="6">
                                        <TextBlock Text="Report MD (ft)"
                                               Style="{StaticResource FieldLabel}"/>
                                        <TextBox Margin="0,6,0,0"
         Text="{Binding Report.MD,
                        Mode=TwoWay}"
                                                 />

                                    </StackPanel>

                                    <StackPanel Margin="6">
                                        <TextBlock Text="Report TVD (ft)"
                                               Style="{StaticResource FieldLabel}"/>
                                        <TextBox Margin="0,6,0,0"
         Text="{Binding Report.TVD,
                        Mode=TwoWay}"/>

                                    </StackPanel>

                                </UniformGrid>

                            </StackPanel>

                        </Border>


                        <!-- ================= OPERATIONAL ================= -->
                        <Border Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="Operational Data"
                                       Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,0,0,14">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="6">
                                        <TextBlock Text="Well Section" Style="{StaticResource FieldLabel}"/>

                                        <ComboBox 
        ItemsSource="{Binding WellSectionOptions}" 
        SelectedItem="{Binding Report.WellSection, Mode=TwoWay}" 
        IsEditable="False"
        Margin="0,6,0,0"
        Height="35"
                                            FontSize="14"/>
                                        <!-- aquí defines el ancho -->
                                    </StackPanel>


                                    <StackPanel Grid.Column="1"
                Margin="6">

                                        <TextBlock Text="Max BHT (MWD / PWD)"
                   Style="{StaticResource FieldLabel}"/>

                                        <TextBox Margin="0,6,0,0"
         Text="{Binding Report.MaxBHT,
                        Mode=TwoWay}"/>


                                    </StackPanel>

                                </Grid>



                                <StackPanel Margin="6,0,6,14">

                                    <TextBlock Text="Present Activity"
                                           Style="{StaticResource FieldLabel}"
                                               
/>

                                    <TextBox Text="{Binding Report.PresentActivity,
                UpdateSourceTrigger=PropertyChanged}"
         Margin="0,6,0,0"/>


                                </StackPanel>


                                <Grid Margin="6">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="Primary Fluid Set"
                                               Style="{StaticResource FieldLabel}"/>

                                        <TextBox Margin="0,6,0,0"
         Text="{Binding Report.PrimaryFluidSet,
                        Mode=TwoWay}"/>


                                    </StackPanel>


                                    <Button Grid.Column="1"
                                        Content="⚙ Manage"
                                        Style="{StaticResource LinkButton}"
                                        Margin="10,0,0,13"
                                        VerticalAlignment="Bottom"/>

                                </Grid>

                            </StackPanel>

                        </Border>


                        <!-- ================= PERSONNEL ================= -->
                        <TextBlock Text="Personnel on Rig"
                               Style="{StaticResource PageTitle}"
                               Margin="0,20,0,10"/>


                        <!-- Operator Reps -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Operator Representative(s)" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Add and remove names as needed for this report."
                        Style="{StaticResource SubtleHint}"
                        Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding Report.OperatorReps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PersonRowCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                            Text="{Binding}"
                                            Style="{StaticResource PersonName}"/>

                                                    <Button Grid.Column="1"
                                         Content="✕"
                                         Style="{StaticResource RemoveIconButton}"
                                         Click="RemoveOperator_Click"
                                         Tag="{Binding}"
                                         ToolTip="Remove"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtNewOperator"
                          Grid.Column="0"
                          Margin="0,0,10,0"/>

                                    <Button Grid.Column="1"
                         Content="+ Add"
                         Style="{StaticResource AddButton}"
                         Click="AddOperator_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Contractor Reps -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Contractor Representative(s)" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Keep this list tight—only who matters on-site."
                        Style="{StaticResource SubtleHint}"
                        Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding Report.ContractorReps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PersonRowCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                            Text="{Binding}"
                                            Style="{StaticResource PersonName}"/>

                                                    <Button Grid.Column="1"
                                         Content="✕"
                                         Style="{StaticResource RemoveIconButton}"
                                         Click="RemoveContractor_Click"
                                         Tag="{Binding}"
                                         ToolTip="Remove"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtNewContractor"
                          Grid.Column="0"
                          Margin="0,0,10,0"/>

                                    <Button Grid.Column="1"
                         Content="+ Add"
                         Style="{StaticResource AddButton}"
                         Click="AddContractor_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GSA reps -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="GSA Representative(s)" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Same game: add, remove, ship the report."
                        Style="{StaticResource SubtleHint}"
                        Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding Report.BaroidReps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PersonRowCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                            Text="{Binding}"
                                            Style="{StaticResource PersonName}"/>

                                                    <Button Grid.Column="1"
                                         Content="✕"
                                         Style="{StaticResource RemoveIconButton}"
                                         Click="RemoveBaroid_Click"
                                         Tag="{Binding}"
                                         ToolTip="Remove"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtNewBaroid"
                          Grid.Column="0"
                          Margin="0,0,10,0"/>

                                    <Button Grid.Column="1"
                         Content="+ Add"
                         Style="{StaticResource AddButton}"
                         Click="AddBaroid_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>


                        <!-- ================= ACTION BAR ================= -->
                        <Border Margin="0,24,0,0"
                            Padding="14"
                            Background="{StaticResource Surface}"
                            CornerRadius="8">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Make sure all required fields are completed before saving."
                                       VerticalAlignment="Center"
                                       Foreground="Gray"/>

                                <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">


                                    <Button Content="Save Report"
        Style="{StaticResource PrimaryButton}"
        MinWidth="140"
        Command="{Binding SaveNewReportCommand}"/>


                                </StackPanel>

                            </Grid>

                        </Border>


                    </StackPanel>

                </Grid>

            </Border>

        </ScrollViewer>

    </Border>


</UserControl>
