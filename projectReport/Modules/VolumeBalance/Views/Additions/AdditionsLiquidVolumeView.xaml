<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.Additions.AdditionsLiquidVolumeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="900">

    <UserControl.Resources>

        <!-- CARD -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- HEADER -->
        <Style x:Key="HeaderCellStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EE7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- CELDAS CENTRADAS REALMENTE -->
        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>

        <!-- READ ONLY VISUAL -->
        <Style x:Key="ReadOnlyCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource CenteredCellStyle}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

    </UserControl.Resources>

    <!-- ===================== -->
    <!-- CARD -->
    <!-- ===================== -->
    <Border Style="{StaticResource CardStyle}">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE -->
            <TextBlock Text="ADDITIONS LIQUID VOLUME (bbl)"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <!-- TABLE -->
            <DataGrid Grid.Row="1"
                      Height="220"
                      ItemsSource="{Binding AdditionsLiquidVolumes}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      BorderBrush="#E5E7EB"
                      HorizontalGridLinesBrush="#E5E7EB"
                      VerticalGridLinesBrush="#E5E7EB"
                      ColumnHeaderStyle="{StaticResource HeaderCellStyle}">

                <DataGrid.Columns>

                    <!-- READ ONLY -->
                    <DataGridTextColumn Header="Pit System"
                                        Binding="{Binding PitSystem}"
                                        IsReadOnly="True"
                                        CellStyle="{StaticResource ReadOnlyCellStyle}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Fluid Subtype"
                                        Binding="{Binding FluidSubtype}"
                                        IsReadOnly="True"
                                        CellStyle="{StaticResource ReadOnlyCellStyle}"
                                        Width="*"/>

                    <!-- EDITABLE -->
                    <DataGridTextColumn Header="Water"
                                        Binding="{Binding Water, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        CellStyle="{StaticResource CenteredCellStyle}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Dewatering Water"
                                        Binding="{Binding DewateringWater, Mode=TwoWay}"
                                        CellStyle="{StaticResource CenteredCellStyle}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Osmosis Water"
                                        Binding="{Binding OsmosisWater, Mode=TwoWay}"
                                        CellStyle="{StaticResource CenteredCellStyle}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Oil Based"
                                        Binding="{Binding OilBased, Mode=TwoWay}"
                                        CellStyle="{StaticResource CenteredCellStyle}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Iflux"
                                        Binding="{Binding Iflux, Mode=TwoWay}"
                                        CellStyle="{StaticResource CenteredCellStyle}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Border>

</UserControl>