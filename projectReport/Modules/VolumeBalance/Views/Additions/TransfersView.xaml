<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.Additions.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ProjectReport.Modules.VolumeBalance.Views.Additions"
             xmlns:vm="clr-namespace:ProjectReport.Modules.VolumeBalance.ViewModels"
             xmlns:converters="clr-namespace:ProjectReport.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:TransfersViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>

        <converters:SmartNumberConverter x:Key="SmartNumberConverter"/>


        <!-- ===================================================== -->
        <!-- CARD -->
        <!-- ===================================================== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ===================================================== -->
        <!-- COLUMN HEADER (DEFAULT) -->
        <!-- ===================================================== -->
        <Style x:Key="HeaderCellStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EE7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0.5"/>
        </Style>

        <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- ===================================================== -->
        <!-- ADD BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EE7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#EE7D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EE7D32"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#EE7D32"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================================== -->
        <!-- DELETE BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#991B1B"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- CARD -->
    <Border Style="{StaticResource CardStyle}">

        <Grid Margin="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================== -->
            <!-- TITLE -->
            <!-- ===================== -->

            <TextBlock Grid.Row="0"
                   Text="TRANSFERS"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

            <!-- ===================== -->
            <!-- ADD TRANSFER -->
            <!-- ===================== -->

            <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="5">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <!-- FROM -->

                    <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">

                        <TextBlock Text="FROM"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                        

                        <ComboBox
                            Height="20"
    ItemsSource="{Binding FromOptions}"
    SelectedItem="{Binding SelectedFrom}"
    DisplayMemberPath="DisplayName"/>
                    </StackPanel>

                    <!-- TO -->

                    <StackPanel Grid.Column="1"
                            Margin="0,0,10,0">

                        <TextBlock Text="TO"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                        <ComboBox
                        Height="20"
ItemsSource="{Binding ToOptions}"
SelectedItem="{Binding SelectedTo}"
DisplayMemberPath="DisplayName"/>
                        
                    </StackPanel>

                    <!-- VOL -->

                    <StackPanel Grid.Column="2"
                            Margin="0,0,10,0">

                        <TextBlock Text="VOL (bbl)"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                        <TextBox Height="20"
         PreviewTextInput="TransferVolume_PreviewTextInput"
         PreviewKeyDown="TransferVolume_PreviewKeyDown"
         Text="{Binding TransferVolume,
                        Converter={StaticResource SmartNumberConverter},
                        UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <!-- BUTTON -->

                    <Button Grid.Column="3"
                        Height="20"
                        Width="120"
                        Margin="0,22,0,0"
                        Content="+ Add"
                        Style="{StaticResource AddButtonStyle}"
                        Command="{Binding AddTransferCommand}"/>

                </Grid>

            </Border>

            <!-- ===================== -->
            <!-- TABLE -->
            <!-- ===================== -->

            <DataGrid Grid.Row="3"
                  Margin="0,5,0,0"
                  Height="300"
                  ItemsSource="{Binding Transfers}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  FontSize="11"
                  ColumnHeaderHeight="32"
                  RowHeight="28"
                  GridLinesVisibility="Horizontal"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFAFA"
                  BorderBrush="#E5E7EB"
                  HorizontalGridLinesBrush="#E5E7EB"
                  VerticalGridLinesBrush="#E5E7EB"
                  ColumnHeaderStyle="{StaticResource HeaderCellStyle}">

                <DataGrid.Columns>

                    <!-- FROM -->

                    <DataGridTextColumn Header="FROM"
                    Binding="{Binding FromDisplay}"
                    Width="3*"
                    IsReadOnly="True">

                        <DataGridTextColumn.ElementStyle>
                            <StaticResource ResourceKey="CenteredTextStyle"/>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>

                    <!-- TO -->

                    <DataGridTextColumn Header="TO"
                    Binding="{Binding ToDisplay}"
                    Width="3*"
                    IsReadOnly="True">

                        <DataGridTextColumn.ElementStyle>
                            <StaticResource ResourceKey="CenteredTextStyle"/>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>

                    <!-- VOL -->

                    <DataGridTextColumn Header="VOL (bbl)"
                    Binding="{Binding Vol}"
                    Width="1.2*">

                        <DataGridTextColumn.ElementStyle>
                            <StaticResource ResourceKey="CenteredTextStyle"/>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>

                    <!-- DELETE -->

                    <DataGridTemplateColumn Width="70"
                                        Header="">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Button Content="Delete"
        Width="60"
        Height="20"
        Style="{StaticResource DeleteButtonStyle}"
        Command="{Binding DataContext.DeleteTransferCommand,
                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
        CommandParameter="{Binding}"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Border>
</UserControl>
