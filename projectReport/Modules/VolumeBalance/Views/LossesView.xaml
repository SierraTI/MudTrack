<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.LossesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:ProjectReport.Modules.VolumeBalance.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <viewModels:LossesViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <!--==============================-->
        <!-- FONDO -->
        <!--==============================-->

        <SolidColorBrush x:Key="BackgroundBrush"
                     Color="#F3F4F6"/>

        <!--==============================-->
        <!-- CARD -->
        <!--==============================-->

        <Style x:Key="CardStyle"
           TargetType="Border">

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="CornerRadius"
                Value="16"/>

            <Setter Property="Padding"
                Value="14"/>

            <Setter Property="Margin"
                Value="10"/>

            <Setter Property="BorderBrush"
                Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                Value="1"/>

        </Style>

        <!--==============================-->
        <!-- DATAGRID -->
        <!--==============================-->

        <Style TargetType="DataGrid">

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="HeadersVisibility"
                Value="Column"/>

            <Setter Property="GridLinesVisibility"
                Value="Horizontal"/>

            <Setter Property="RowHeight"
                Value="20"/>

            <Setter Property="ColumnHeaderHeight"
                Value="30"/>

            <Setter Property="CanUserAddRows"
                Value="False"/>

            <Setter Property="ScrollViewer.CanContentScroll"
                Value="True"/>

        </Style>

        <!--==============================-->
        <!-- HEADERS -->
        <!--==============================-->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                Value="#EE7D32"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        </Style>

        <!--==============================-->
        <!-- CELDAS -->
        <!--==============================-->

        <Style TargetType="DataGridCell">

            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        </Style>

        <!--==============================-->
        <!-- TEXTOS -->
        <!--==============================-->

        <Style x:Key="CenteredTextBlock"
           TargetType="TextBlock">

            <Setter Property="HorizontalAlignment"
                Value="Center"/>

            <Setter Property="VerticalAlignment"
                Value="Center"/>

            <Setter Property="TextAlignment"
                Value="Center"/>

        </Style>

        <!--==============================-->
        <!-- TEXTBOX -->
        <!--==============================-->

        <Style x:Key="CenteredTextBox"
           TargetType="TextBox">

            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter Property="TextAlignment"
                Value="Center"/>

        </Style>

        <!--==============================-->
        <!-- COMBOBOX -->
        <!--==============================-->

        <Style x:Key="CenteredComboBox"
       TargetType="ComboBox">

            <Setter Property="HorizontalAlignment"
            Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
            Value="Center"/>

            <Setter Property="VerticalContentAlignment"
            Value="Center"/>

            <Setter Property="VerticalAlignment"
            Value="Center"/>

            <Setter Property="Padding"
            Value="4"/>

            <Setter Property="MinHeight"
            Value="26"/>

        </Style>

        <!--==============================-->
        <!-- ADD BUTTON -->
        <!--==============================-->

        <Style x:Key="AddButtonStyle"
           TargetType="Button">

            <Setter Property="Background"
                Value="#EE7D32"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="BorderBrush"
                Value="#EE7D32"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="MinWidth"
                Value="120"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="border"
                                    Property="Background"
                                    Value="#BA560D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="border"
                                    Property="Background"
                                    Value="#BA560D"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                 Value="False">

                                <Setter TargetName="border"
                                    Property="Opacity"
                                    Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!--==============================-->
        <!-- DELETE BUTTON -->
        <!--==============================-->

        <Style x:Key="DeleteButtonStyle"
           TargetType="Button">

            <Setter Property="Background"
                Value="#DC2626"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="BorderBrush"
                Value="#B91C1C"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="MinWidth"
                Value="80"/>

            <Setter Property="HorizontalAlignment"
                Value="Center"/>

            <Setter Property="VerticalAlignment"
                Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="border"
                                    Property="Background"
                                    Value="#EF4444"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="border"
                                    Property="Background"
                                    Value="#991B1B"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                 Value="False">

                                <Setter TargetName="border"
                                    Property="Opacity"
                                    Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  CanContentScroll="True">

            <StackPanel>

                <!-- ===================== -->
                <!-- TÍTULO -->
                <!-- ===================== -->
                <Border Background="White"
                    CornerRadius="12"
                    Margin="20,20,20,10"
                    Padding="14"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Título -->
                        <TextBlock Grid.Column="0"
               Text="LOSSES (bbl)"
               FontSize="18"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>

                        <!-- Centro -->
                        <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                            <TextBlock Text="Select Fluid Combination:"
                   Margin="0,0,10,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#6B7280"
                   VerticalAlignment="Center"/>

                            <ComboBox Width="250"
          Height="20"
          Margin="0,0,10,0"
          VerticalAlignment="Center"
          ItemsSource="{Binding FluidCombinations}"
          SelectedItem="{Binding SelectedFluidCombination}"
          DisplayMemberPath="FluidDisplay"/>

                        </StackPanel>

                        <!-- Botón -->
                        <Button Grid.Column="2"
            Width="120"
            Content="Add"
            HorizontalAlignment="Right"
            Style="{StaticResource AddButtonStyle}"
            Command="{Binding AddCommand}"/>

                    </Grid>

                </Border>

                <!-- ===================== -->
                <!-- TABLA -->
                <!-- ===================== -->
                <Border Style="{StaticResource CardStyle}"
                    Margin="20,0,20,20">

                    <DataGrid ItemsSource="{Binding Losses}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="False"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          Height="320">

                        <DataGrid.Resources>

                            <!-- TextBlock -->
                            <Style x:Key="CenteredTextBlock"
                               TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>

                            <!-- TextBox -->
                            <Style x:Key="CenteredTextBox"
                               TargetType="TextBox">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>

                            <!-- ComboBox -->
                            <Style x:Key="CenteredComboBox"
                               TargetType="ComboBox">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="MinHeight" Value="26"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>

                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <!-- PIT SYSTEM -->
                            <DataGridTextColumn
                            Header="Pit System"
                            Width="*"
                            Binding="{Binding PitSystem}"
                            IsReadOnly="True"
                            ElementStyle="{StaticResource CenteredTextBlock}"/>

                            <!-- FLUID TYPE -->
                            <DataGridTextColumn
                            Header="Fluid Type"
                            Width="*"
                            Binding="{Binding FluidType}"
                            IsReadOnly="True"
                            ElementStyle="{StaticResource CenteredTextBlock}"/>

                            <!-- FLUID SUBTYPE -->
                            <DataGridTextColumn
                            Header="Fluid Subtype"
                            Width="*"
                            Binding="{Binding FluidSubtype}"
                            IsReadOnly="True"
                            ElementStyle="{StaticResource CenteredTextBlock}"/>

                            <!-- LOSSES TYPE -->
                            <DataGridTemplateColumn Header="Losses Type"
                                                Width="*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <ComboBox
                                        ItemsSource="{Binding DataContext.LossesTypes,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedItem="{Binding SelectedLossesType,
                                                               Mode=TwoWay,
                                                               UpdateSourceTrigger=PropertyChanged}"
                                        DisplayMemberPath="Name"
                                        Style="{StaticResource CenteredComboBox}"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- LOSSES SUBTYPE -->
                            <DataGridTemplateColumn Header="Losses SubType"
                                                Width="*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <ComboBox
                                        ItemsSource="{Binding FilteredLossesSubTypes}"
                                        SelectedItem="{Binding SelectedLossesSubType,
                                                               Mode=TwoWay,
                                                               UpdateSourceTrigger=PropertyChanged}"
                                        DisplayMemberPath="Name"
                                        Style="{StaticResource CenteredComboBox}"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- VOLUME -->
                            <DataGridTextColumn
                            Header="Volume (bbl)"
                            Width="120"
                            Binding="{Binding Volume,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                            ElementStyle="{StaticResource CenteredTextBlock}"
                            EditingElementStyle="{StaticResource CenteredTextBox}"/>

                            <!-- DELETE -->
                            <DataGridTemplateColumn
                            Header=""
                            Width="90"
                            IsReadOnly="True">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button Content="Delete"
                                            Width="70"
                                            Height="24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DeleteButtonStyle}"
                                            Command="{Binding DataContext.DeleteCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>