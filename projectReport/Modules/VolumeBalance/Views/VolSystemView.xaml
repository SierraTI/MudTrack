<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.VolSystemView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:vm="clr-namespace:ProjectReport.Modules.VolumeBalance.ViewModels"
          mc:Ignorable="d"
          d:DesignHeight="450"
          d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:VolSystemViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- ========================= -->
        <!-- COLORS -->
        <!-- ========================= -->

        <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F4F6"/>

        <!-- ========================= -->
        <!-- CARD -->
        <!-- ========================= -->

        <Style x:Key="CardStyle"
           TargetType="Border">

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="CornerRadius"
                Value="16"/>

            <Setter Property="Padding"
                Value="16"/>

            <Setter Property="Margin"
                Value="20,10"/>

            <Setter Property="BorderBrush"
                Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                Value="1"/>

        </Style>

        <!-- ========================= -->
        <!-- DATAGRID -->
        <!-- ========================= -->

        <Style TargetType="DataGrid">

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="BorderBrush"
                Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="HeadersVisibility"
                Value="Column"/>

            <Setter Property="GridLinesVisibility"
                Value="None"/>

            <Setter Property="AutoGenerateColumns"
                Value="False"/>

            <Setter Property="CanUserAddRows"
                Value="False"/>

            <Setter Property="CanUserDeleteRows"
                Value="False"/>

            <Setter Property="CanUserResizeRows"
                Value="False"/>

            <Setter Property="SelectionMode"
                Value="Single"/>

            <Setter Property="SelectionUnit"
                Value="Cell"/>

            <Setter Property="RowHeight"
                Value="44"/>

            <Setter Property="ColumnHeaderHeight"
                Value="42"/>

            <Setter Property="RowHeaderWidth"
                Value="0"/>

            <Setter Property="HorizontalGridLinesBrush"
                Value="#F3F4F6"/>

        </Style>

        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                Value="#EE7D32"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter Property="BorderThickness"
                Value="0"/>

        </Style>

        <!-- ========================= -->
        <!-- ROW -->
        <!-- ========================= -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="VerticalAlignment"
                Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                     Value="True">

                    <Setter Property="Background"
                        Value="#FFF7ED"/>

                </Trigger>

                <Trigger Property="IsSelected"
                     Value="True">

                    <Setter Property="Background"
                        Value="#FFE9D5"/>

                    <Setter Property="Foreground"
                        Value="#111827"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ========================= -->
        <!-- CELL -->
        <!-- ========================= -->

        <Style TargetType="DataGridCell">

            <Setter Property="Padding"
                Value="8,4"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="FocusVisualStyle"
                Value="{x:Null}"/>

            <Setter Property="TextBlock.TextAlignment"
                Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                     Value="True">

                    <Setter Property="Background"
                        Value="#FFE9D5"/>

                    <Setter Property="Foreground"
                        Value="#111827"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Text inside grid cells -->
        <Style x:Key="GridCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- ========================= -->
        <!-- COMBOBOX -->
        <!-- ========================= -->

        <Style x:Key="GridComboStyle"
       TargetType="ComboBox">

            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- Border -->
                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"/>

                            <!-- Contenido seleccionado (ESTO ARREGLA EL BLANCO) -->
                            <ContentPresenter Margin="8,0,30,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <!-- FLECHA (IMPORTANTE para UX) -->
                            <TextBlock Text="▼"
                               FontSize="10"
                               Foreground="#6B7280"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               IsHitTestVisible="False"/>

                            <!-- Botón invisible que abre dropdown -->
                            <ToggleButton IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0"/>

                            <!-- LISTA -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False">

                                <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinWidth="{Binding ActualWidth,
                                RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- TITLE -->

                <Border Background="White"
                    CornerRadius="12"
                    Margin="20,20,20,10"
                    Padding="14"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                    <TextBlock Text="VOLUME SYSTEM"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>

                </Border>

                <!-- PITS -->

                <Border Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="PITS VOLUME (bbl)"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               Foreground="#111827"/>

                        <DataGrid x:Name="PitsDataGrid"
                              ItemsSource="{Binding Pits}"
                              Height="300"
                              ColumnWidth="*"
                              MinColumnWidth="60"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">

                            <DataGrid.LayoutTransform>
                                <ScaleTransform x:Name="GridScale" ScaleX="1" ScaleY="1" />
                            </DataGrid.LayoutTransform>

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Pit System"
                                                    Width="*">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <ComboBox Style="{StaticResource GridComboStyle}"
                  SelectedValue="{Binding PitSystem, Mode=TwoWay}"
                  SelectedValuePath="Content">

                                                <ComboBoxItem Content="Activo"/>
                                                <ComboBoxItem Content="Reserva"/>
                                                <ComboBoxItem Content="Otro"/>

                                            </ComboBox>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Pit Name"
                                                Binding="{Binding PitName}"
                                                ElementStyle="{StaticResource GridCellTextStyle}" />

                                <DataGridTemplateColumn Header="Fluid Type" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding FluidType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Loaded="FluidCombo_Loaded"
                                                      Style="{StaticResource GridComboStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Fluid Subtype"
                                                Binding="{Binding FluidSubtype, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource GridCellTextStyle}"
                                                IsReadOnly="False" />

                                <DataGridTextColumn Header="Previous Volume"
                                                Binding="{Binding PreviousVolume, StringFormat=N2}"
                                                ElementStyle="{StaticResource GridCellTextStyle}" />

                                <DataGridTextColumn Header="Current Volume"
                                                Binding="{Binding CurrentVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                ElementStyle="{StaticResource GridCellTextStyle}"
                                                IsReadOnly="False" />

                                <DataGridTextColumn Header="Density"
                                                Binding="{Binding Density, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                ElementStyle="{StaticResource GridCellTextStyle}"
                                                IsReadOnly="False" />

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

                <!-- HOLE VOLUME -->

                <Border Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="HOLE VOLUME (bbl)"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               Foreground="#111827"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Hole Volume"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                            <Border Grid.Column="1"
                                Background="#F9FAFB"
                                CornerRadius="8"
                                Padding="8"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">

                                <TextBlock Text="0.00"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>

