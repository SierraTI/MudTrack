<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.VolSystemView"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:vm="clr-namespace:ProjectReport.Modules.VolumeBalance.ViewModels"
          xmlns:conv="clr-namespace:ProjectReport.Converters"
          mc:Ignorable="d"
          d:DesignHeight="450"
          d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:VolSystemViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <conv:SmartNumberConverter x:Key="SmartNumberConverter"/>

        <!-- ========================= -->
        <!-- COLORS -->
        <!-- ========================= -->

        <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F4F6"/>

        <!-- ========================= -->
        <!-- CARD -->
        <!-- ========================= -->

        <Style x:Key="CardStyle"
           TargetType="Border">

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="CornerRadius"
                Value="16"/>

            <Setter Property="Padding"
                Value="16"/>

            <Setter Property="Margin"
                Value="20,10"/>

            <Setter Property="BorderBrush"
                Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                Value="1"/>

        </Style>

        <!-- ========================= -->
        <!-- DATAGRID -->
        <!-- ========================= -->

        <Style TargetType="DataGrid">

            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="HeadersVisibility" Value="Column"/>

            <!-- Mostrar líneas horizontales y verticales -->
            <Setter Property="GridLinesVisibility" Value="All"/>

            <Setter Property="HorizontalGridLinesBrush" Value="#D1D5DB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D1D5DB"/>

            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>

            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>

            <Setter Property="RowHeight" Value="25"/>
            <Setter Property="ColumnHeaderHeight" Value="22"/>
            <Setter Property="RowHeaderWidth" Value="0"/>

        </Style>

        <Style x:Key="ReadOnlyCellStyle"
       TargetType="TextBlock">

            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

        </Style>

        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                Value="#EE7D32"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                Value="Center"/>

            <Setter Property="BorderThickness"
                Value="0"/>

        </Style>

        <!-- ========================= -->
        <!-- ROW -->
        <!-- ========================= -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="VerticalAlignment"
                Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                     Value="True">

                    <Setter Property="Background"
                        Value="#FFF7ED"/>

                </Trigger>

                <Trigger Property="IsSelected"
                     Value="True">

                    <Setter Property="Background"
                        Value="#FFE9D5"/>

                    <Setter Property="Foreground"
                        Value="#111827"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ========================= -->
        <!-- CELL -->
        <!-- ========================= -->

        <Style TargetType="DataGridCell">

            <Setter Property="Padding" Value="4,2"/>

            <!-- Delineado de cada celda -->
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0.5"/>

            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Background" Value="White"/>

            <Style.Triggers>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE9D5"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="GridCellTextStyleFluidSubtype" TargetType="TextBlock">

            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsFluidSubtypeModified}" Value="False">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsFluidSubtypeModified}" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="GridCellTextStyleCurrentVolume" TargetType="TextBlock">

            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsCurrentVolumeModified}" Value="False">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsCurrentVolumeModified}" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="GridCellTextStyleDensity" TargetType="TextBlock">

            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsDensityModified}" Value="False">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E40AF"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsDensityModified}" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="GridCellTextStylePreviousVolume"
       TargetType="TextBlock">

            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

        </Style>

        <!-- ========================= -->
        <!-- COMBOBOX -->
        <!-- ========================= -->
        <Style x:Key="GridComboStyle"
       TargetType="ComboBox">

            <Setter Property="OverridesDefaultStyle"
            Value="True"/>

            <Setter Property="FocusVisualStyle"
            Value="{x:Null}"/>

            <Setter Property="Height"
            Value="24"/>

            <Setter Property="Margin"
            Value="2"/>

            <Setter Property="Padding"
            Value="4,0"/>

            <Setter Property="Background"
            Value="White"/>

            <Setter Property="Foreground"
            Value="#111827"/>

            <Setter Property="BorderBrush"
            Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
            Value="1"/>

            <Setter Property="HorizontalContentAlignment"
            Value="Left"/>

            <Setter Property="VerticalContentAlignment"
            Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"/>

                            <ContentPresenter Margin="8,0,30,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <TextBlock Text="▼"
                               FontSize="10"
                               Foreground="#6B7280"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               IsHitTestVisible="False"/>

                            <ToggleButton
                        Focusable="False"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        IsChecked="{Binding IsDropDownOpen,
                        RelativeSource={RelativeSource TemplatedParent},
                        Mode=TwoWay}">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False">

                                <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinWidth="{Binding ActualWidth,
                                RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocusWithin"
                             Value="True">

                                <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="#D1D5DB"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
        <Style TargetType="ComboBoxItem">

            <Setter Property="Background"
            Value="White"/>

            <Setter Property="Foreground"
            Value="#111827"/>

            <Setter Property="Padding"
            Value="8,4"/>

            <Setter Property="FocusVisualStyle"
            Value="{x:Null}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="Bd"
                        Background="White"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Sin azul al pasar el mouse -->
                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="Bd"
                                Property="Background"
                                Value="#F9FAFB"/>

                            </Trigger>

                            <!-- Seleccionado -->
                            <Trigger Property="IsSelected"
                             Value="True">

                                <Setter TargetName="Bd"
                                Property="Background"
                                Value="#F3F4F6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- PITS -->
        <!-- ========================================================= -->

        <Border
        Grid.Row="0"
        Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- TÍTULO -->
                <!-- ================================================= -->

                <TextBlock
                Grid.Row="0"
                Text="PITS VOLUME (bbl)"
                FontSize="14"
                FontWeight="SemiBold"
                Margin="0,0,0,10"
                Foreground="#111827"/>


                <!-- ================================================= -->
                <!-- TABLA -->
                <!-- ================================================= -->

                <DataGrid
                Grid.Row="1"
                x:Name="PitsDataGrid"
                ItemsSource="{Binding Pits}"
                ColumnWidth="*"
                MinColumnWidth="60"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.CanContentScroll="True"
                VerticalAlignment="Stretch"
                CanUserResizeColumns="True"
                IsReadOnly="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                FocusVisualStyle="{x:Null}"
                IsSynchronizedWithCurrentItem="False">


                    <!-- ================================================= -->
                    <!-- ESCALA -->
                    <!-- ================================================= -->

                    <DataGrid.LayoutTransform>

                        <ScaleTransform
                        x:Name="GridScale"
                        ScaleX="1"
                        ScaleY="1"/>

                    </DataGrid.LayoutTransform>


                    <!-- ================================================= -->
                    <!-- COLUMNAS -->
                    <!-- ================================================= -->

                    <DataGrid.Columns>


                        <!-- ================================================= -->
                        <!-- PIT SYSTEM -->
                        <!-- ================================================= -->

                        <DataGridTemplateColumn
                        Header="Pit System"
                        Width="*">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <ComboBox
    ItemsSource="{Binding DataContext.PitSystemOptions,
        RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
    DisplayMemberPath="Name"
    SelectedValuePath="PitSystemId"
    SelectedValue="{Binding PitSystemId,
        Mode=TwoWay,
        UpdateSourceTrigger=Explicit}"
    SelectionChanged="PitSystemComboBox_SelectionChanged"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- ================================================= -->
                        <!-- PIT SYSTEM ID - TEMPORAL PARA PRUEBAS -->
                        <!-- ================================================= -->

                        <!--<DataGridTextColumn
                        Header="Pit System ID"
                        Binding="{Binding PitSystemId}"
                        Width="100"
                        IsReadOnly="True"/>-->


                        <!-- ================================================= -->
                        <!-- PIT NAME -->
                        <!-- ================================================= -->

                        <DataGridTextColumn
                        Header="Pit Name"
                        Binding="{Binding PitName}"
                        IsReadOnly="True">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter
                                    Property="HorizontalAlignment"
                                    Value="Center"/>

                                    <Setter
                                    Property="TextAlignment"
                                    Value="Center"/>

                                    <Setter
                                    Property="VerticalAlignment"
                                    Value="Center"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>


                            <DataGridTextColumn.CellStyle>

                                <Style TargetType="DataGridCell">

                                    <Setter
                                    Property="Background"
                                    Value="#E5E7EB"/>

                                    <Setter
                                    Property="BorderThickness"
                                    Value="0"/>

                                </Style>

                            </DataGridTextColumn.CellStyle>

                        </DataGridTextColumn>


                        <!-- ================================================= -->
                        <!-- FLUID TYPE -->
                        <!-- ================================================= -->


                        <DataGridTemplateColumn
    Header="Fluid Type"
    Width="200">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <ComboBox
                ItemsSource="{Binding DataContext.FluidTypeOptions,
                    RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"

                SelectedValuePath="Id"

                SelectedValue="{Binding FluidTypeId,
                    Mode=TwoWay,
                    UpdateSourceTrigger=PropertyChanged}"

                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                                        <!-- ============================================= -->
                                        <!-- TEXTO QUE SE MUESTRA EN LA LISTA -->
                                        <!-- ============================================= -->

                                        <ComboBox.ItemTemplate>

                                            <DataTemplate>

                                                <TextBlock
                            Text="{Binding DisplayName}"
                            HorizontalAlignment="Center"/>

                                            </DataTemplate>

                                        </ComboBox.ItemTemplate>

                                    </ComboBox>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- ================================================= -->
                        <!-- FLUID SUBTYPE -->
                        <!-- ================================================= -->

                        <DataGridTextColumn
                        Header="Fluid Subtype"
                        Binding="{Binding FluidSubtype,
                            Mode=TwoWay,
                            UpdateSourceTrigger=LostFocus}"
                        ElementStyle="{StaticResource GridCellTextStyleFluidSubtype}" />


                        <!-- ================================================= -->
                        <!-- PREVIOUS VOLUME -->
                        <!-- ================================================= -->

                        <DataGridTemplateColumn
    Header="Previous Volume">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock
    Text="{Binding PreviousVolumeText}"
    Style="{StaticResource GridCellTextStylePreviousVolume}"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                        <!-- ================================================= -->
                        <!-- CURRENT VOLUME -->
                        <!-- ================================================= -->

                        <DataGridTemplateColumn
                        Header="Current Volume">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock
                                    Text="{Binding CurrentVolumeText}"
                                    Style="{StaticResource GridCellTextStyleCurrentVolume}"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>


                            <DataGridTemplateColumn.CellEditingTemplate>

                                <DataTemplate>

                                    <TextBox
                                    Text="{Binding CurrentVolumeText,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}"
                                    PreviewTextInput="NumericOnly_PreviewTextInput"
                                    DataObject.Pasting="NumericOnly_Pasting"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>


                        <!-- ================================================= -->
                        <!-- DENSITY -->
                        <!-- ================================================= -->

                        <DataGridTemplateColumn
                        Header="Density">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <TextBlock
                                    Text="{Binding DensityText}"
                                    Style="{StaticResource GridCellTextStyleDensity}"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>


                            <DataGridTemplateColumn.CellEditingTemplate>

                                <DataTemplate>

                                    <TextBox
                                    Text="{Binding DensityText,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}"
                                    PreviewTextInput="NumericOnly_PreviewTextInput"
                                    DataObject.Pasting="NumericOnly_Pasting"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>


                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- HOLE VOLUME -->
        <!-- ========================================================= -->

        <Border
        Grid.Row="1"
        Style="{StaticResource CardStyle}"
        Margin="20,0,20,20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- LABEL -->
                <!-- ================================================= -->

                <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center">

                    <TextBlock
                    Text="🕳"
                    FontSize="16"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"/>

                    <TextBlock
                    Text="Hole Volume"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#374151"
                    VerticalAlignment="Center"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- VALOR -->
                <!-- ================================================= -->

                <Border
                Grid.Column="1"
                Background="#DBEAFE"
                CornerRadius="14"
                Padding="12,4">

                    <TextBlock
                    Text="0.0"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="#1D4ED8"/>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>

