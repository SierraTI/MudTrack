<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.VolumeBalanceEventView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ProjectReport.Modules.VolumeBalance.Views">

    <UserControl.Resources>

        <!-- 🎨 PALETA -->
        <SolidColorBrush x:Key="BackgroundSoft" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#EE7D32"/>

        <!-- ========================= -->
        <!-- BOTÓN BASE -->
        <!-- ========================= -->
        <Style x:Key="BaseActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- BACK -->
        <Style x:Key="BackButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseActionButton}">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- EXPORT -->
        <Style x:Key="ExportButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseActionButton}">

            <Setter Property="Background" Value="#EE7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#D97706"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F97316"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C2410C"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- TAB STYLE -->
        <Style x:Key="SegmentedButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EE7D32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ========================= -->
    <!-- ROOT -->
    <!-- ========================= -->
    <Grid Background="{StaticResource BackgroundSoft}" x:Name="RootGrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <!--<Border Grid.Row="0"
                Background="White"
                CornerRadius="16"
                Padding="18"
                Margin="20,20,20,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                --><!-- TITLE --><!--
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Text="Event Detail"/>

                --><!-- BUTTONS --><!--
                <StackPanel Grid.Column="1" Orientation="Horizontal">

                    <Button Content="Back"
                            Style="{StaticResource BackButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="Export"
                            Style="{StaticResource ExportButtonStyle}"/>

                </StackPanel>

            </Grid>

        </Border>-->

        <!-- ================= BODY ================= -->
        <Grid Grid.Row="2" Margin="20,10,20,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="550"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="16"
                    Padding="10"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <views:VolumeInfoTableView/>

            </Border>

            <!-- RIGHT -->
            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TABS -->
                <Border Background="White"
                        CornerRadius="14"
                        Padding="6"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">

                    <UniformGrid x:Name="TabsPanel" Columns="4">

                        <ToggleButton Content="Vol System"
                                      Tag="VolSystem"
                                      Style="{StaticResource SegmentedButtonStyle}"
                                      Click="Tab_Click"/>

                        <ToggleButton Content="Additions"
                                      Tag="Additions"
                                      Style="{StaticResource SegmentedButtonStyle}"
                                      Click="Tab_Click"/>

                        <ToggleButton Content="Losses"
                                      Tag="Losses"
                                      Style="{StaticResource SegmentedButtonStyle}"
                                      Click="Tab_Click"/>

                        <ToggleButton Content="Concentrations"
                                      Tag="Concentrations"
                                      Style="{StaticResource SegmentedButtonStyle}"
                                      Click="Tab_Click"/>

                    </UniformGrid>

                </Border>

                <!-- CONTENT -->
                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="16"
                        Padding="20">

                    <ContentControl x:Name="MainContent"/>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>