<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.VolumeBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="ReadOnlySectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValueHighlight" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Sync Bar -->
            <RowDefinition Height="Auto"/> <!-- Universal Balance Bar -->
            <RowDefinition Height="*"/>    <!-- Tab Control -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER (Title and Sync info) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Volume Balance" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Grid.Column="0"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Last synced: " VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock Text="{Binding LastSyncedAt}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#333" Margin="0,0,12,0"/>
                <Button Content="↻ Sync Now" Command="{Binding SyncCommand}" Padding="12,4" Background="#E0E0E0" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <!-- 2. UNIVERSAL BALANCE BAR (Sticky Top) -->
        <Border Grid.Row="1" Background="{Binding VarianceColor}" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Density -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Avg Density" Foreground="White" FontSize="11" Opacity="0.9"/>
                    <TextBlock Text="{Binding AverageActualSurfaceDensity, StringFormat={}{0:F2} ppg}" Foreground="White" FontWeight="Bold" FontSize="18"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Width="1" Fill="White" Opacity="0.4" Margin="0,2"/>

                <!-- Active Volume -->
                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Total Active" Foreground="White" FontSize="11" Opacity="0.9"/>
                    <TextBlock Text="{Binding TotalActiveSurfaceVolume, StringFormat={}{0:F1} bbl}" Foreground="White" FontWeight="Bold" FontSize="18"/>
                </StackPanel>
                
                <!-- Variance and Status (Center Aligned) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="BALANCE:" FontWeight="Bold" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SystemVariance, StringFormat={}{0:+0.0;-0.0;0.0} bbl}" FontWeight="Bold" FontSize="26" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VarianceTrend}" FontSize="12" Foreground="White" FontWeight="Bold" Opacity="0.8" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                </StackPanel>

                <!-- Action Button for Rollover -->
                <Button Grid.Column="8" Content="Update Yesterday Vol" Command="{Binding RolloverCommand}" 
                        Background="White" Foreground="{Binding VarianceColor}" FontWeight="Bold" BorderThickness="0" Padding="12,6" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 3. MAIN TAB CONTROL -->
        <TabControl Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0">
            
            <!-- SCREEN 1: SYSTEM VOLUME -->
            <TabItem Header="System Volume" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel Orientation="Vertical">
                        
                        <!-- Top Summary row for this screen -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Wellbore Overview -->
                            <Border Grid.Column="0" Background="#F1F8E9" BorderBrush="#C5E1A5" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Wellbore Inventory (Actuals)" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="Internal String Vol:" Grid.Row="0"/>
                                        <TextBox Text="{Binding StringActual, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Width="80" HorizontalContentAlignment="Right" Margin="0,2"/>
                                        
                                        <TextBlock Text="Annular Vol:" Grid.Row="1"/>
                                        <TextBox Text="{Binding AnnulusActual, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Width="80" HorizontalContentAlignment="Right" Margin="0,2"/>
                                        
                                        <TextBlock Text="Total Wellbore:" Grid.Row="2" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding TotalWellActual, StringFormat={}{0:F1} bbl}" Grid.Row="2" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Density Info -->
                            <Border Grid.Column="2" Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="System Density" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="Actual (Avg Surface):" Grid.Row="0" Margin="0,4"/>
                                        <TextBlock Text="{Binding AverageActualSurfaceDensity, StringFormat={}{0:F2} ppg}" Grid.Row="0" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        
                                        <TextBlock Text="Theoretical (w/ Chemicals):" Grid.Row="1" Margin="0,4"/>
                                        <TextBlock Text="{Binding TheoreticalSystemDensity, StringFormat={}{0:F2} ppg}" Grid.Row="1" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Pit Inventory -->
                        <TextBlock Text="Surface Tanks" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding SurfaceTanks}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tank Name" Binding="{Binding Name}" Width="150" IsReadOnly="True" FontWeight="SemiBold"/>
                                
                                                                <DataGridComboBoxColumn Header="Classification" Width="110" SelectedItemBinding="{Binding Classification, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGridComboBoxColumn.ItemsSource>
                                        <x:Array Type="{x:Type sys:String}">
                                            <sys:String>Active</sys:String>
                                            <sys:String>Reserve</sys:String>
                                            <sys:String>Other</sys:String>
                                        </x:Array>
                                    </DataGridComboBoxColumn.ItemsSource>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="Fluid Type" Binding="{Binding FluidType}" Width="100"/>
                                
                                <DataGridTemplateColumn Header="Density" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Density, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Yest. Vol (bbl)" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding YesterdayVol, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Right" Foreground="#555"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTemplateColumn Header="Actual Vol (bbl)" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding VolumeBbl, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Right" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Max (bbl)" Binding="{Binding MaxCapacity, StringFormat=F1}" Width="80" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,0,4,0"/>
                                            <Setter Property="Foreground" Value="#999"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SCREEN 2: LOSSES & GAINS -->
            <TabItem Header="Losses &amp; Gains (Since Yest.)" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- GAINS -->
                        <StackPanel Grid.Column="0">
                            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" Padding="8" CornerRadius="4" Margin="0,0,0,16">
                                <TextBlock Text="GAINS (+ bbl)" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                            </Border>

                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Water / Base Fluid Added:" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox Text="{Binding WaterAdded, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" HorizontalContentAlignment="Right"/>

                                <TextBlock Text="Transferred In (From Camp/Mix):" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox Text="{Binding TransfersIn, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="Chemical Details" FontWeight="Bold" Margin="0,0,0,4"/>
                            <DataGrid ItemsSource="{Binding ChemicalUsages}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" RowHeight="28" MinHeight="100">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding QtyUsed, StringFormat=N0}" Width="50"/>
                                    <DataGridTextColumn Header="Vol" Binding="{Binding VolumeAdded, StringFormat=F1}" Width="50" IsReadOnly="True" FontWeight="Bold"/>
                                    <DataGridTemplateColumn Width="30">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="×" Command="{Binding DataContext.RemoveChemicalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="Red" FontSize="14" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="+ Add Chemical Line" Command="{Binding AddChemicalCommand}" HorizontalAlignment="Left" Margin="0,4,0,16"/>

                            <Separator Margin="0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Total Gains:" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding TotalGains, StringFormat={}{0:F1} bbl}" FontWeight="Bold" FontSize="16" Foreground="#2E7D32"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- LOSSES -->
                        <StackPanel Grid.Column="2">
                            <Border Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1" Padding="8" CornerRadius="4" Margin="0,0,0,16">
                                <TextBlock Text="LOSSES (- bbl)" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Center"/>
                            </Border>

                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Surface Losses (Spills, Shakers):" Grid.Row="0" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox Text="{Binding SurfaceLosses, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" HorizontalContentAlignment="Right"/>

                                <TextBlock Text="Transferred Out (Disposal, etc):" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                                <TextBox Text="{Binding TransfersOut, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Right"/>
                            </Grid>

                            <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="Sub-Surface / Formation Losses" FontWeight="Bold" Margin="0,0,0,8"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total Downhole Loss:" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SubSurfaceLosses, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" HorizontalContentAlignment="Right" FontWeight="Bold" Foreground="#C62828"/>
                                    </Grid>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Time Elapsed (hrs):" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding HoursElapsed, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" HorizontalContentAlignment="Right"/>
                                    </Grid>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Rate: " FontStyle="Italic"/>
                                        <TextBlock Text="{Binding SeepageRate, StringFormat={}{0:F2} bbl/hr}" FontStyle="Italic" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,24,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Total Losses:" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding TotalLosses, StringFormat={}{0:F1} bbl}" FontWeight="Bold" FontSize="16" Foreground="#C62828"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- SCREEN 3: GRAND SUMMARY -->
            <TabItem Header="Grand Summary" Padding="16,8">
                <Grid Margin="24">
                    <!-- The Golden Equation visual table -->
                    <Border BorderBrush="#1565C0" BorderThickness="2" CornerRadius="8" Background="White" VerticalAlignment="Top" HorizontalAlignment="Center" Width="700">
                        <StackPanel>
                            <Border Background="#1565C0" Padding="12" CornerRadius="6,6,0,0">
                                <TextBlock Text="Final Accountability (Accounting vs Physical)" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Yesterday Totals -->
                                <TextBlock Text="1. Total System Yesterday" Grid.Row="0" FontWeight="SemiBold" FontSize="14" Margin="0,8"/>
                                <TextBlock Text="{Binding SystemTotalYesterday, StringFormat={}{0:F1} bbl}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" FontSize="14" Margin="0,8"/>

                                <!-- Additions -->
                                <TextBlock Text="2. Total System GAINS" Grid.Row="1" FontWeight="SemiBold" FontSize="14" Margin="0,8"/>
                                <TextBlock Text="{Binding TotalGains, StringFormat={}+ {0:F1} bbl}" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Foreground="#2E7D32" FontWeight="Bold" FontSize="14" Margin="0,8"/>

                                <!-- Reductions -->
                                <TextBlock Text="3. Total System LOSSES" Grid.Row="2" FontWeight="SemiBold" FontSize="14" Margin="0,8"/>
                                <TextBlock Text="{Binding TotalLosses, StringFormat={}- {0:F1} bbl}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Foreground="#C62828" FontWeight="Bold" FontSize="14" Margin="0,8"/>

                                <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12" Background="#CCC"/>

                                <!-- Accounting Total -->
                                <TextBlock Text="ACCOUNTING TARGET (1 + 2 - 3)" Grid.Row="4" FontWeight="Bold" FontSize="16" Margin="0,8"/>
                                <TextBlock Text="{Binding AccountingTotal, StringFormat={}{0:F1} bbl}" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Margin="0,8" Foreground="#555"/>

                                <!-- Physical Total -->
                                <TextBlock Text="SURFACE EQUIP. USED" Grid.Row="5" FontWeight="SemiBold" FontSize="14" Margin="0,8"/>
                                <TextBlock Text="{Binding SurfaceEquipmentVolumeUsed, StringFormat={}{0:F1} bbl}" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" FontSize="14" Margin="0,8"/>

                                <TextBlock Text="PHYSICAL ACTUAL (Pits + Hole + Surface)" Grid.Row="6" FontWeight="Bold" FontSize="16" Margin="0,8"/>
                                <TextBlock Text="{Binding PhysicalTotal, StringFormat={}{0:F1} bbl}" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Margin="0,8"/>
                            </Grid>
                            
                            <Border Background="#F5F5F5" Padding="24,16" CornerRadius="0,0,6,6" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="VARIANCE (Actual - Target) : " FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SystemVariance, StringFormat={}{0:+0.0;-0.0;0.0} bbl}" FontSize="24" FontWeight="Bold" Foreground="{Binding VarianceColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>



