<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.VolumeBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1450">

    <!-- MODERN COLOR PALETTE -->

    <UserControl.Resources>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#EE7D32"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#D96B21"/>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="CardBrush" Color="White"/>

        <SolidColorBrush x:Key="BorderBrushCustom" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="TextBrush" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="GrayBrush" Color="#6D6D6D"/>

        <SolidColorBrush x:Key="RowBrush" Color="#FAFAFA"/>

        <SolidColorBrush x:Key="SuccessBrush" Color="#DFF4E4"/>
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#2F7D32"/>

        <!-- BUTTON STYLE -->

        <Style x:Key="ModernButtonStyle"
               TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <!-- MAIN -->

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="1.15*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL VOLUME BALANCE EVENTS -->

        <Border Grid.Column="0"
                Background="{StaticResource CardBrush}"
                CornerRadius="18"
                Padding="22"
                Margin="15"
                BorderBrush="{StaticResource BorderBrushCustom}"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Volume Balance Events"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>



                    </StackPanel>

                    <Button Grid.Column="1"
        Content="+ ADD EVENT"
        Width="140"
        Height="42"
        Style="{StaticResource ModernButtonStyle}"
        Command="{Binding AddEventCommand}"/>
                </Grid>

                <Border Grid.Row="2"
                        Background="#FFF4EC"
                        CornerRadius="10"
                        Padding="14">

                    <TextBlock Text="Daily Operation Events"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>

                </Border>


                <Border Grid.Row="4"
                        CornerRadius="14"
                        BorderBrush="{StaticResource BorderBrushCustom}"
                        BorderThickness="1">

                    <DataGrid ItemsSource="{Binding Events}"
          AutoGenerateColumns="False"
          HeadersVisibility="Column"
          CanUserAddRows="False"
          GridLinesVisibility="None"
          BorderThickness="0"
          Background="White"
          AlternatingRowBackground="{StaticResource RowBrush}"
          AlternationCount="2"
          MinRowHeight="45"
          VerticalContentAlignment="Center"
          HorizontalContentAlignment="Stretch">

                        <!-- 🔥 FIX GLOBAL DE CELDAS -->
                        <DataGrid.Resources>

                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="6"/>
                            </Style>

                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                        </DataGrid.Resources>

                        <!-- HEADER -->
                        <DataGrid.ColumnHeaderStyle>

                            <Style TargetType="DataGridColumnHeader">

                                <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>

                            </Style>

                        </DataGrid.ColumnHeaderStyle>

                        <!-- ROW -->
                        <DataGrid.RowStyle>

                            <Style TargetType="DataGridRow">

                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>

                            </Style>

                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <!-- DELETE -->
                            <DataGridTemplateColumn Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Center">

                                            <Button Content="✕"
                                Width="28"
                                Height="28"
                                FontWeight="Bold"
                                Foreground="#E53935"
                                Background="#FFF1F1"
                                BorderThickness="0"
                                Cursor="Hand"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Id"
         Binding="{Binding Id}"
         Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            
                            <!-- HORA -->
                            <DataGridTextColumn Header="Hora"
                            Binding="{Binding Hora}"
                            Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- DESCRIPTION 🔥 FIX DEFINITIVO -->
                            <DataGridTextColumn Header="Description"
                            Binding="{Binding Description}"
                            Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Left"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="6,2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- DEPTH -->
                            <DataGridTextColumn Header="Current Depth"
                            Binding="{Binding CurrentDepth}"
                            Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- ACTIVITY -->
                            <DataGridTextColumn Header="Activity"
                            Binding="{Binding Activity}"
                            Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- VIEW -->
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Center">

                                            <Button Content="View"
        Width="70"
        Height="30"
        Background="#EFEFEF"
        Foreground="#444"
        BorderThickness="0"
        FontWeight="SemiBold"
        Command="{Binding DataContext.ViewEventCommand,
                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
        CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- EXPORT -->
                            <DataGridTemplateColumn Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Center">

                                            <Button Content="Export"
                                Width="80"
                                Height="30"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>
                </Border>

            </Grid>

        </Border>
        
        <!-- RIGHT PANEL SUMMARY VOLUME -->
      
        <Border Grid.Column="2"
                Background="White"
                CornerRadius="18"
                Padding="24"
                Margin="15"
                BorderBrush="{StaticResource BorderBrushCustom}"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                 <!--TITLE--> 

                <StackPanel>

                    <TextBlock Text="Summary Volume"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="Current drilling volume balance"
                               FontSize="13"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource GrayBrush}"/>

                </StackPanel>

                 <!--TABLE-->

                <Border Grid.Row="2"
        Background="#FAFAFA"
        CornerRadius="14"
        Padding="12">

                    <Viewbox Stretch="Uniform">

                        <Grid Width="500">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1.25*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>

                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER -->

                            <Border Grid.Column="1"
                    Grid.Row="0"
                    Margin="2"
                    CornerRadius="8"
                    Background="{StaticResource PrimaryBrush}">

                                <TextBlock Text="Previous Volume (bbl)"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

               
                            </Border>
                            

                            <Border Grid.Column="2"
                    Grid.Row="0"
                    Margin="2"
                    CornerRadius="8"
                    Background="{StaticResource PrimaryBrush}">

                                <TextBlock Text="Current Volume (bbl)"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>
                            
                            

                            <!-- FILA 1 -->

                            <TextBlock Grid.Row="1"
                       Text="Riser w/o Pipe"
                       FontSize="12"
                       Margin="6,0"
                       VerticalAlignment="Center"/>

                            <Border Grid.Row="1"
                    Grid.Column="1"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5"/>

                            <Border Grid.Row="1"
                    Grid.Column="2"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5">

                                <TextBlock Text="0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>

                            <!-- FILA 2 -->

                            <TextBlock Grid.Row="2"
                       Text="Casing w/o Pipe"
                       FontSize="12"
                       Margin="6,0"
                       VerticalAlignment="Center"/>

                            <Border Grid.Row="2"
                    Grid.Column="1"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5"/>

                            <Border Grid.Row="2"
                    Grid.Column="2"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5">

                                <TextBlock Text="0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>

                            <!-- FILA 3 -->

                            <TextBlock Grid.Row="3"
                       Text="Open Hole w/o Pipe"
                       FontSize="12"
                       Margin="6,0"
                       VerticalAlignment="Center"/>

                            <Border Grid.Row="3"
                    Grid.Column="1"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5"/>

                            <Border Grid.Row="3"
                    Grid.Column="2"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5">

                                <TextBlock Text="0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>

                            <!-- FILA 4 -->

                            <TextBlock Grid.Row="4"
                       Text="Annular"
                       FontSize="12"
                       Margin="6,0"
                       VerticalAlignment="Center"/>

                            <Border Grid.Row="4"
                    Grid.Column="1"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5"/>

                            <Border Grid.Row="4"
                    Grid.Column="2"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5">

                                <TextBlock Text="0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>

                            <!-- FILA 5 -->

                            <TextBlock Grid.Row="5"
                       Text="String Capacity"
                       FontSize="12"
                       Margin="6,0"
                       VerticalAlignment="Center"/>

                            <Border Grid.Row="5"
                    Grid.Column="1"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5"/>

                            <Border Grid.Row="5"
                    Grid.Column="2"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5">

                                <TextBlock Text="0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>

                            <!-- FILA 6 -->

                            <TextBlock Grid.Row="6"
                       Text="String Displacement"
                       FontSize="12"
                       Margin="6,0"
                       VerticalAlignment="Center"/>

                            <Border Grid.Row="6"
                    Grid.Column="1"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5"/>

                            <Border Grid.Row="6"
                    Grid.Column="2"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5">

                                <TextBlock Text="0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>

                            <!-- FILA 7 -->

                            <TextBlock Grid.Row="7"
                       Text="Total Hole"
                       FontWeight="Bold"
                       FontSize="12"
                       Margin="6,0"
                       VerticalAlignment="Center"/>

                            <Border Grid.Row="7"
                    Grid.Column="1"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5"/>

                            <Border Grid.Row="7"
                    Grid.Column="2"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5">

                                <TextBlock Text="0"
                           FontWeight="Bold"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>

                            <!-- FILA 8 -->

                            <TextBlock Grid.Row="8"
                       Text="Total Active"
                       FontSize="12"
                       Margin="6,0"
                       VerticalAlignment="Center"/>

                            <Border Grid.Row="8"
                    Grid.Column="1"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5"/>

                            <Border Grid.Row="8"
                    Grid.Column="2"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5">

                                <TextBlock Text="40"
                           FontWeight="Bold"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>

                            <!-- FILA 9 -->

                            <TextBlock Grid.Row="9"
                       Text="Total Reserve"
                       FontSize="12"
                       Margin="6,0"
                       VerticalAlignment="Center"/>

                            <Border Grid.Row="9"
                    Grid.Column="1"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5"/>

                            <Border Grid.Row="9"
                    Grid.Column="2"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5">

                                <TextBlock Text="0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>

                            <!-- FILA 10 -->

                            <TextBlock Grid.Row="10"
                       Text="Total Other"
                       FontSize="12"
                       Margin="6,0"
                       VerticalAlignment="Center"/>

                            <Border Grid.Row="10"
                    Grid.Column="1"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5"/>

                            <Border Grid.Row="10"
                    Grid.Column="2"
                    BorderBrush="#DADADA"
                    BorderThickness="0.5">

                                <TextBlock Text="0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                    </Viewbox>

                </Border>

                <!--STATUS--> 

                <StackPanel Grid.Row="4">

                    <Border Background="{StaticResource SuccessBrush}"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="BALANCE VOL"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>

                            <TextBlock Grid.Column="1"
                                       Text="OK"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessTextBrush}"/>

                        </Grid>

                    </Border>

                    <Border Background="{StaticResource SuccessBrush}"
                            CornerRadius="12"
                            Padding="14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="BALANCE QUIMICA"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>

                            <TextBlock Grid.Column="1"
                                       Text="OK"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessTextBrush}"/>

                        </Grid>

                    </Border>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>