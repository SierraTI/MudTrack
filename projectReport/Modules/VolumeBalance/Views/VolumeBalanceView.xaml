<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.VolumeBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:models="clr-namespace:ProjectReport.Modules.VolumeBalance.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:ProjectReport.Modules.VolumeBalance.Converters"
             d:DesignHeight="900"
             d:DesignWidth="1400">

    <UserControl.Resources>

        <!-- Encabezados DataGrid -->
        <Style x:Key="CenteredHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#EE7D32"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Height"
                    Value="42"/>

        </Style>

        <!-- Cell style for summary table -->
        <Style x:Key="SummaryCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <!-- Botón Principal -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#EE7D32"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

        <conv:HeightOffsetConverter x:Key="HeightOffsetConverter" />
        <conv:WidthLessThanConverter x:Key="WidthLessThanConverter" />
        <!-- Celdas centradas -->
        <Style x:Key="CenteredCellStyle"
       TargetType="DataGridCell">

            <Setter Property="HorizontalContentAlignment"
            Value="Center"/>

            <Setter Property="VerticalContentAlignment"
            Value="Center"/>

            <Setter Property="TextBlock.TextAlignment"
            Value="Center"/>

            <Setter Property="Foreground"
            Value="#374151"/>

            <Setter Property="Padding"
            Value="8,0"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="Background"
            Value="Transparent"/>

            <Style.Triggers>

                <Trigger Property="IsSelected"
                 Value="True">

                    <Setter Property="Background"
                    Value="#FFF4EC"/>

                    <Setter Property="Foreground"
                    Value="#374151"/>

                    <Setter Property="BorderBrush"
                    Value="#EE7D32"/>

                    <Setter Property="BorderThickness"
                    Value="1"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Botones de acciones -->
        <Style x:Key="ActionButtonStyle"
       TargetType="Button">

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="FontWeight"
            Value="SemiBold"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="Padding"
            Value="12,5"/>

            <Setter Property="Margin"
            Value="3"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="Border"
                                Property="Opacity"
                                Value="0.85"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- Filas modernas -->
        <Style x:Key="ModernRowStyle"
       TargetType="DataGridRow">

            <Setter Property="Height"
            Value="42"/>

            <Setter Property="VerticalAlignment"
            Value="Center"/>

            <Setter Property="Background"
            Value="White"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                 Value="True">

                    <Setter Property="Background"
                    Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Grid Background="#F5F7FA">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <!-- ========================= -->
        <!-- COLUMNA IZQUIERDA -->
        <!-- ========================= -->

        <Grid Grid.Column="0"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ADD -->

            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="15"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <DockPanel>
                    <Button Content="+ ADD EVENT"
                            Width="170"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddEventCommand}"/>
                </DockPanel>

            </Border>

            <!-- EVENTOS -->

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12*"/>
                        <ColumnDefinition Width="799*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="EVENTOS DURANTE EL DÍA"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#374151" Grid.ColumnSpan="2" Margin="0,0,0,15" Grid.RowSpan="2"/>

                    <DataGrid Grid.Row="2"
          Grid.ColumnSpan="2"
          ItemsSource="{Binding Events}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="False"
          BorderThickness="0"
          HeadersVisibility="Column"
          ColumnHeaderStyle="{StaticResource CenteredHeaderStyle}"
          CellStyle="{StaticResource CenteredCellStyle}"
          RowStyle="{StaticResource ModernRowStyle}"
          RowBackground="White"
          AlternatingRowBackground="#F8FAFC"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#E5E7EB"
          VerticalGridLinesBrush="#E5E7EB"
          RowHeight="42"
          SelectionUnit="Cell"
          SelectionMode="Extended">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Hora"
                            Width="120"
                            IsReadOnly="True"
                            Binding="{Binding Hora}" />

                            <DataGridTextColumn Header="Descripción"
                            Width="*"
                            Binding="{Binding Description,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}" />

                            <DataGridTextColumn Header="Current Depth"
                            Width="140"
                            Binding="{Binding CurrentDepth,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}" />

                            <DataGridTextColumn Header="Actividad"
                            Width="150"
                            Binding="{Binding Activity,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}" />

                            <DataGridTemplateColumn Header="Acciones"
                                Width="220">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                                            <Button Content="👁 View"
                                Width="90"
                                Background="#EE7D32"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding DataContext.ViewEventCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />

                                            <Button Content="📄 Export"
                                Width="90"
                                Background="#10B981"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding DataContext.ExportEventCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />

                                        </StackPanel>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

        <!-- ========================= -->
        <!-- COLUMNA DERECHA -->
        <!-- ========================= -->

        <Border Grid.Column="2"
                Margin="20"
                Background="White"
                CornerRadius="12"
                Padding="20"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <!-- Make summary table size to its content to avoid large empty space -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titulo -->

                <TextBlock Text="SUMMARY VOLUME"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#374151"/>

                <!-- Responsive: compact styles and sizes for small screens -->
                <Grid Grid.Row="2" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.Resources>
                        <Style TargetType="TextBlock" x:Key="CompactHeaderStyle">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>

                        <Style TargetType="TextBlock" x:Key="CompactCellStyle" BasedOn="{StaticResource SummaryCellTextStyle}">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="2,1" />
                        </Style>
                    </Grid.Resources>

                    <!-- Single DataGrid with Concepto / Previous / Current so rows align perfectly -->
                    <DataGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              VerticalAlignment="Top"
                              MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HeightOffsetConverter}, ConverterParameter=180}"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource CenteredHeaderStyle}"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F8FAEB"
                              VerticalGridLinesBrush="Transparent"
                              RowHeight="30"
                              HorizontalAlignment="Stretch"
                              SelectionMode="Single"
                              SelectionUnit="Cell"
                              Focusable="False">

                        <DataGrid.Items>
                            <models:VolumeSummaryRow Name="Riser w/o Pipe" Previous="0" Current="0" />
                            <models:VolumeSummaryRow Name="Casing w/o Pipe" Previous="0" Current="0" />
                            <models:VolumeSummaryRow Name="Open Hole w/o Pipe" Previous="0" Current="0" />
                            <models:VolumeSummaryRow Name="Annular" Previous="0" Current="0" />
                            <models:VolumeSummaryRow Name="String Capacity" Previous="0" Current="0" />
                            <models:VolumeSummaryRow Name="String Displacement" Previous="0" Current="0" />
                            <models:VolumeSummaryRow Name="Total Hole" Previous="0" Current="0" />
                            <models:VolumeSummaryRow Name="Total Active" Previous="0" Current="0" />
                            <models:VolumeSummaryRow Name="Total Reserve" Previous="0" Current="0" />
                            <models:VolumeSummaryRow Name="Total Other" Previous="0" Current="0" />
                        </DataGrid.Items>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CompactCellStyle}" />
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>


                            <DataGridTextColumn Header="Previous" Binding="{Binding Previous}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CompactCellStyle}" />
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CompactCellStyle}" />
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

                <!-- Balances -->

                <StackPanel Grid.Row="4">

                    <Border Background="#DCFCE7"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,5">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="BALANCE VOL"/>

                            <TextBlock Grid.Column="1"
                                       Text="OK"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="#15803D"/>

                        </Grid>

                    </Border>

                    <Border Background="#DCFCE7"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,5">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="BALANCE QUÍMICA"/>

                            <TextBlock Grid.Column="1"
                                       Text="OK"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="#15803D"/>

                        </Grid>

                    </Border>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>