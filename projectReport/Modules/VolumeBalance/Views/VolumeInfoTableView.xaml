<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.VolumeInfoTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProjectReport.Modules.VolumeBalance.Models">

    <UserControl.Resources>

        <!-- 🎨 PALETA SUAVE -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#EE7D32"/>
        <SolidColorBrush x:Key="SoftBg" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="TextMain" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedBlueGray" Color="#E9EEF5"/>
        <SolidColorBrush x:Key="HeaderSoft" Color="#F3F6FA"/>

        <!-- 🌫️ SHADOW -->
        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="18"
                          ShadowDepth="2"
                          Opacity="0.10"/>

        <!-- 📦 CARD -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>

        <!-- 📊 DATAGRID BASE -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

        <!-- HEADER MODERNO SUAVE -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderSoft}"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- FILAS -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBg"
                                Background="{TemplateBinding Background}">
                            <DataGridCellsPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg"
                                        Property="Background"
                                        Value="#F3F6FA"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg"
                                        Property="Background"
                                        Value="#FFEFE6"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CELDAS -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <!-- ================= ROOT ================= -->
    <Grid Background="{StaticResource SoftBg}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <Grid MaxWidth="1200"
                  HorizontalAlignment="Center"
                  Margin="12">

                <StackPanel>

                    <!-- ===================================================== -->
                    <!-- VOLUME INFORMATION -->
                    <!-- ===================================================== -->
                    <Border Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <TextBlock Text="Volume Information (bbl)"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}"
                                       Margin="0,0,0,10"/>

                            <DataGrid>

                                <DataGrid.Columns>

                                    <!-- PILL STYLE FIRST COLUMN -->
                                    <DataGridTemplateColumn Header="Pit System"
                                                            Width="3*">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>

                                                <Border Background="{StaticResource MutedBlueGray}"
                                                        CornerRadius="6"
                                                        Padding="6"
                                                        Margin="2">

                                                    <TextBlock Text="{Binding PitSystem}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#374151"
                                                               TextWrapping="Wrap"/>

                                                </Border>

                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Active"
                                                        Binding="{Binding Active}" />

                                    <DataGridTextColumn Header="Reserve"
                                                        Binding="{Binding Reserve}" />

                                    <DataGridTextColumn Header="Other"
                                                        Binding="{Binding Other}" />

                                </DataGrid.Columns>

                                <DataGrid.Items>

                                    <local:VolumeRow PitSystem="Volumen Final evento anterior"
                                                     Active="120.00"
                                                     Reserve="80.00"
                                                     Other="10.00"/>

                                    <local:VolumeRow PitSystem="Evento actual - Total Fluid Additions"
                                                     Active="15.00"
                                                     Reserve="0.00"
                                                     Other="0.00"/>

                                    <local:VolumeRow PitSystem="Water Additions"
                                                     Active="8.00"
                                                     Reserve="0.00"
                                                     Other="0.00"/>

                                    <local:VolumeRow PitSystem="Oil Based Additions"
                                                     Active="4.00"
                                                     Reserve="0.00"
                                                     Other="0.00"/>

                                    <local:VolumeRow PitSystem="Chemical Additions"
                                                     Active="3.00"
                                                     Reserve="0.00"
                                                     Other="0.00"/>

                                    <local:VolumeRow PitSystem="Daily Losses"
                                                     Active="-10.00"
                                                     Reserve="0.00"
                                                     Other="0.00"/>

                                    <local:VolumeRow PitSystem="End Volume"
                                                     Active="125.00"
                                                     Reserve="80.00"
                                                     Other="10.00"/>

                                </DataGrid.Items>

                            </DataGrid>

                        </StackPanel>

                    </Border>

                    <!-- ===================================================== -->
                    <!-- CHEMICAL ADDED -->
                    <!-- ===================================================== -->
                    <Border Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <TextBlock Text="Chemical Added (bbl)"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}"
                                       Margin="0,0,0,10"/>

                            <DataGrid>

                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="Pit System"
                                                            Width="2*">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>

                                                <Border Background="{StaticResource MutedBlueGray}"
                                                        CornerRadius="6"
                                                        Padding="6"
                                                        Margin="2">

                                                    <TextBlock Text="{Binding PitSystem}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#374151"/>

                                                </Border>

                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Fluid Type"
                                                        Binding="{Binding FluidType}" />

                                    <DataGridTextColumn Header="Subtype"
                                                        Binding="{Binding Subtype}" />

                                    <DataGridTextColumn Header="Vol (bbl)"
                                                        Binding="{Binding Volume}" />

                                </DataGrid.Columns>

                                <DataGrid.Items>

                                    <local:ChemicalRow PitSystem="Active"
                                                       FluidType="Water Based"
                                                       Subtype="Fresh Water"
                                                       Volume="120.00"/>

                                    <local:ChemicalRow PitSystem="Reserve"
                                                       FluidType="Water Based"
                                                       Subtype="Brine"
                                                       Volume="45.00"/>

                                    <local:ChemicalRow PitSystem="Oil Based"
                                                       FluidType="Oil Based"
                                                       Subtype="Diesel"
                                                       Volume="30.00"/>

                                    <local:ChemicalRow PitSystem="Chemical"
                                                       FluidType="Chemical"
                                                       Subtype="Caustic Soda"
                                                       Volume="12.00"/>

                                    <local:ChemicalRow PitSystem="Other"
                                                       FluidType="Chemical"
                                                       Subtype="Barite"
                                                       Volume="18.00"/>

                                </DataGrid.Items>

                            </DataGrid>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>