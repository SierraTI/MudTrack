<UserControl x:Class="ProjectReport.Modules.VolumeBalance.Views.VolumeInfoTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProjectReport.Modules.VolumeBalance.Models">

    <UserControl.Resources>

        <SolidColorBrush x:Key="SoftBg" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="TextMain" Color="#1F2937"/>
        <SolidColorBrush x:Key="GridBorder" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="HeaderSoft" Color="#F3F6FA"/>
        <SolidColorBrush x:Key="BalanceRowBrush" Color="#FFF3E0"/>
        <SolidColorBrush x:Key="FirstColumnBrush" Color="#EEF2FF"/>

        <!-- CARD -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- DATAGRID -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource GridBorder}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridBorder}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridBorder}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- HEADER CENTRADO -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderSoft}"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource GridBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- CELDAS CENTRADAS -->
        <Style TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource GridBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- ROWS -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>

                <DataTrigger Binding="{Binding Label}" Value="BALANCE VOLUME">
                    <Setter Property="Background" Value="{StaticResource BalanceRowBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F6FA"/>
                </Trigger>

            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource SoftBg}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <Grid MaxWidth="1200"
                  HorizontalAlignment="Center"
                  Margin="12">

                <StackPanel>

                    <!-- ================= TABLE 1 ================= -->
                    <Border Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <TextBlock Text="Volume Information (bbl)"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"
                                       Foreground="{StaticResource TextMain}"/>

                            <DataGrid ItemsSource="{Binding VolumeTable.VolumeInformation}">

                                <DataGrid.Columns>

                                    <!-- PIT SYSTEM (COLOREADO SOLO SI NO ES BALANCE) -->
                                    <DataGridTextColumn Header="Pit System"
                                                        Width="1.5*"
                                                        Binding="{Binding Label}">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">

                                                <!-- mantiene centrado -->
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>

                                                <!-- color de TODA la celda -->
                                                <Setter Property="Background" Value="{StaticResource FirstColumnBrush}"/>

                                                <Style.Triggers>

                                                    <!-- excepción BALANCE VOLUME -->
                                                    <DataTrigger Binding="{Binding Label}" Value="BALANCE VOLUME">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>

                                    <!-- ACTIVE -->
                                    <DataGridTextColumn Header="Active"
                                                        Width="*"
                                                        Binding="{Binding Active, StringFormat={}{0:0.##}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- RESERVE -->
                                    <DataGridTextColumn Header="Reserve"
                                                        Width="*"
                                                        Binding="{Binding Reserve, StringFormat={}{0:0.##}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- OTHER -->
                                    <DataGridTextColumn Header="Other"
                                                        Width="*"
                                                        Binding="{Binding Other, StringFormat={}{0:0.##}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                        </StackPanel>

                    </Border>

                    <!-- ================= TABLE 2 ================= -->
                    <Border Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <TextBlock Text="Chemical Added (bbl)"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"
                                       Foreground="{StaticResource TextMain}"/>

                            <DataGrid ItemsSource="{Binding VolumeTable.ChemicalAdded}">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Pit System"
                                                        Width="1.5*"
                                                        Binding="{Binding PitSystem}"/>

                                    <DataGridTextColumn Header="Fluid Type"
                                                        Width="*"
                                                        Binding="{Binding FluidType}"/>

                                    <DataGridTextColumn Header="Subtype"
                                                        Width="*"
                                                        Binding="{Binding Subtype}"/>

                                    <DataGridTextColumn Header="Vol (bbl)"
                                                        Width="*"
                                                        Binding="{Binding Volume, StringFormat={}{0:0.##}}"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>