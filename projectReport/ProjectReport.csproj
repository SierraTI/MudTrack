<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>

    <OutputType>WinExe</OutputType>

    <TargetFramework>net8.0-windows</TargetFramework>

    <Nullable>enable</Nullable>

    <UseWPF>true</UseWPF>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>

    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>

    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>

    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>

    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>

    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>

    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>

    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <ImplicitUsings>enable</ImplicitUsings>

    <NoWarn>NU1701</NoWarn>

    <UseAppHost>true</UseAppHost>

    <ApplicationIcon>Assets/app.ico</ApplicationIcon>

    <Win32Icon>Assets\app.ico</Win32Icon>

  </PropertyGroup>



  <ItemGroup>

    <None Remove="Assets\Data\Lista.xlsx" />

    <None Remove="Assets\Data\ListaFluidos.xlsx" />

  </ItemGroup>



  <ItemGroup>

    <Content Include="Assets\Data\Lista.xlsx">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

    </Content>

    <Content Include="Assets\Data\ListaFluidos.xlsx">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

    </Content>

    <Content Include="Resources\default_products.json">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

    </Content>

	  <Content Include="Assets\Data\HoleSizeList.xlsx">

		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

	  </Content>

  </ItemGroup>

	<ItemGroup>

		<Content Include="Assets\Data\PosterMapa.pdf">

			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

		</Content>

	</ItemGroup>






  <ItemGroup>

    <Folder Include="Modules\Inventory\Legacy\Models\" />

    <Folder Include="Modules\Inventory\Legacy\Services\" />

    <Folder Include="Modules\Inventory\Legacy\ViewModels\" />

    <Folder Include="Views\Geometry\Modals\" />

    <Folder Include="Views\Geometry\ThermalGradient\" />

  </ItemGroup>



  <!-- Exclude nested duplicate from failed merge (delete projectReport/projectReport/ when app is closed) -->
  <ItemGroup>
    <Compile Remove="projectReport\**\*.cs" />
    <Page Remove="projectReport\**\*.xaml" />
    <ApplicationDefinition Remove="projectReport\**\*.xaml" />
    <EmbeddedResource Remove="projectReport\**\*" />
    <Content Remove="projectReport\**\*" />
    <None Remove="projectReport\**\*" />
  </ItemGroup>

  <!-- Exclude tools/test projects from main compilation wildcards -->

  <ItemGroup>

    <Compile Remove="Tools\**\*.cs" />

    <Content Remove="Tools\**\*" />

    <None Remove="Tools\**\*" />

    <EmbeddedResource Remove="Tools\**\*" />

  </ItemGroup>



  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.864.35" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <Resource Include="Assets\Logo.png" />
    <Resource Include="Assets\FooterLogo.png" />
  </ItemGroup>
</Project>





