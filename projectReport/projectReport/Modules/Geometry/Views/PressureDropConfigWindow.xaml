<Window x:Class="ProjectReport.Views.Geometry.PressureDropConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ProjectReport.Converters"
        Title="Pressure Drop Configuration"
        Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <!-- Converters -->
        <converters:FlowPressureToPpgConverter x:Key="FlowPressureToPpgConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Pressure Drop Profile"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,10"
                   Foreground="{DynamicResource AppPrimaryText}"/>

        <!-- Compatibility Warning -->
        <TextBlock Grid.Row="0"
                   Text="{Binding CompatibilityWarning}"
                   Foreground="Orange"
                   FontWeight="Bold"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,10"
                   Visibility="{Binding CompatibilityWarning, Converter={StaticResource StringToVis}}"/>

        <!-- Main Content (Table + Chart) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Data Table -->
            <DockPanel Grid.Column="0" Margin="0,0,15,0">
                <TextBlock DockPanel.Dock="Top" Text="Data Table" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource AppSecondaryText}"/>
                <DataGrid ItemsSource="{Binding Data}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          Background="{DynamicResource AppCardBackground}"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Flow Rate (gpm)"
                                            Binding="{Binding FlowRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Pressure Drop (psi)"
                                            Binding="{Binding PressureDrop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Chart -->
            <Border Grid.Column="1" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="10" 
                    BorderBrush="{StaticResource TableBorderBrush}" 
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pressure Drop vs. Flow Rate" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource AppSecondaryText}"/>
                    <lvc:CartesianChart xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
                                        Series="{Binding SeriesCollection}"
                                        LegendLocation="None">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Flow Rate (gpm)" LabelFormatter="{Binding XFormatter}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Pressure Drop (psi)" LabelFormatter="{Binding YFormatter}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancel"
                    Width="100" Height="35"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,15,0"
                    Style="{StaticResource DefaultButton}"/>

            <Button Content="Save"
                    Width="100" Height="35"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource DefaultButton}"/>

        </StackPanel>

    </Grid>
</Window>