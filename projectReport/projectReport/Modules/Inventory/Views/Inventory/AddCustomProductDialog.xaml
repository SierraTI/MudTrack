<Window x:Class="ProjectReport.Views.Inventory.AddCustomProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Custom Product"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9FAFB">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <!-- Header -->
        <TextBlock Text="➕ New Product" FontSize="16" FontWeight="Bold"
                   Foreground="#1F2937" Margin="0,0,0,16"/>

        <!-- Code -->
        <TextBlock Text="Code *" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="CodeTextBox" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>

        <!-- Name -->
        <TextBlock Text="Name *" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="NameTextBox" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>

        <!-- Unit -->
        <TextBlock Text="Unit" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="UnitTextBox" Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>

        <!-- SG -->
        <TextBlock Text="SG (Specific Gravity)" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="SgTextBox" Style="{StaticResource InputStyle}" Margin="0,0,0,12" Text="1.0"/>

        <!-- Category -->
        <TextBlock Text="Category" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="CategoryTextBox" Style="{StaticResource InputStyle}" Margin="0,0,0,20"/>

        <!-- Error message -->
        <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12"
                   Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Padding="8,6"
                    Background="#E5E7EB" Foreground="#374151"
                    BorderThickness="0" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Content="✓ Add" Width="90" Padding="8,6"
                    Background="#10B981" Foreground="White"
                    BorderThickness="0"
                    Click="AddButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
