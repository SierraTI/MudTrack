<UserControl x:Class="ProjectReport.Views.Inventory.ChemicalListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">
    <Grid Margin="12">
        <Grid.Resources>
            <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F3F4F6"/>
                <Setter Property="Foreground" Value="#1F2937"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Height" Value="36"/>
            </Style>
            <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="White"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#F9FAFB"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F0F9FF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Chemical List - Select Products" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding TotalItems, StringFormat='Total: {0}'}" 
           FontSize="14" 
           Margin="12,0,0,0" 
           Foreground="#666"/>
        </StackPanel>

        <!-- Search and Filter Bar -->
        <Border Grid.Row="1"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,8"
                Background="#F9FAFB">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#x1F50D; Search:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchTextBox" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="250" 
                         Padding="8"
                         VerticalAlignment="Center"
                         Margin="0,0,16,0"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Foreground="#374151"/>
                
                <TextBlock Text="Category:" FontSize="12" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="CategoryCombo" 
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Width="180" 
                          Padding="8"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"
                          BorderBrush="#D1D5DB"
                          BorderThickness="1">
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Stats Bar -->
        <Border Grid.Row="2"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Background="#FFFBEB">
            <DockPanel LastChildFill="False">
                <Border BorderThickness="0" Background="#FEF3C7" CornerRadius="4" Padding="12,6" DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total:" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding TotalItems}" FontWeight="Bold" Foreground="#92400E"/>
                    </StackPanel>
                </Border>

                <Border BorderThickness="0" Background="#DCFCE7" CornerRadius="4" Padding="12,6" Margin="8,0,0,0" DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Selected:" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Foreground="#166534"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Content="Select All" Width="100" Command="{Binding SelectAllCommand}" 
                           Margin="8,0" Background="#3B82F6" Foreground="White" Padding="8,4"/>
                    <Button Content="Clear Selection" Width="120" Command="{Binding ClearSelectionCommand}" 
                           Margin="0,0,8,0" Background="#EF4444" Foreground="White" Padding="8,4"/>
                    <Button Content="&#x2713; SAVE" Width="120" Command="{Binding SaveCommand}" 
                           Background="#10B981" Foreground="White" Padding="8,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DataGrids with Split View -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Table: Selected Products -->
            <Border Grid.Column="0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,12,4">
                        <TextBlock Text="SELECTED PRODUCTS" 
                                   FontSize="11" FontWeight="Bold" Foreground="#10B981"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <Button Content="&#x2795; Add Product"
                                Command="{Binding AddCustomProductCommand}"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Padding="8,3"
                                Background="#0D9488"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </DockPanel>
                    <DataGrid x:Name="SelectedProductsDataGrid"
                              ItemsSource="{Binding SelectedChemicalItemsView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              SelectionUnit="CellOrRowHeader"
                              SelectionMode="Single"
                              RowHeight="32"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              CellEditEnding="SelectedProductsDataGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="&#x2713;" Binding="{Binding IsSelected}" Width="40"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Unit Price (USD)" Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat=F2}" Width="110"/>
                            <DataGridTextColumn Header="SG" Binding="{Binding SG, UpdateSourceTrigger=LostFocus}" Width="60"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right Table: All Products -->
            <Border Grid.Column="2"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="AVAILABLE PRODUCTS" 
                               FontSize="11" FontWeight="Bold" Foreground="#3B82F6" 
                               Margin="12,8,12,4"/>
                    <DataGrid x:Name="ChemicalsDataGrid"
                              ItemsSource="{Binding ChemicalItemsView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              SelectionUnit="CellOrRowHeader"
                              SelectionMode="Single"
                              RowHeight="32"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource DataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="&#x2713;" Binding="{Binding IsSelected}" Width="40"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="180" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Physical State" Binding="{Binding PhysicalState}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Presentation" Binding="{Binding Presentation}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Qty/Pkg" Binding="{Binding Quantity}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SG" Binding="{Binding SG}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer Info -->
        <TextBlock Grid.Row="5" Text="Scroll horizontally to see all columns &#x2022; Use checkboxes to select products for your daily report" 
                   FontSize="11" Foreground="#6B7280" Margin="0,4,0,0"/>

    </Grid>
</UserControl>
